---
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import TerminalOverlay from '../components/generic/TerminalOverlay.astro';
import CompileScreen from '../components/generic/CompileScreen.astro';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
// Tailwind temporarily disabled — its Vite plugin drops global CSS

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <meta name="description" content={description || "Venkat Sundaraneedi — Rust & Blockchain Developer"} />
    <title>{title || "Venkat Sundaraneedi | Portfolio"}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <ClientRouter />
    <style is:inline>
      ::-webkit-scrollbar{width:22px;background-color:#fff}
      ::-webkit-scrollbar-track{background:linear-gradient(45deg,#000 25%,transparent 25%,transparent 75%,#000 75%,#000),linear-gradient(45deg,#000 25%,transparent 25%,transparent 75%,#000 75%,#000);background-color:#fff;background-size:4px 4px;background-position:0 0,2px 2px;width:10px;border-left:3px solid #000}
      ::-webkit-scrollbar-thumb{width:20px;box-sizing:content-box;background-color:#fff;border:2px solid #000;border-right:none}
      ::-webkit-scrollbar-thumb:hover{background:#fde047}
    </style>
  </head>
  <body>
    <CompileScreen />
    <div class="container">
      <Header />
      <slot />
      <Footer />
    </div>
    <TerminalOverlay />
    <script>
      // Guard: only run setup once (window persists across ClientRouter navigations)
      if (!(window as any).__portfolioSetup) {
        (window as any).__portfolioSetup = true;

        console.log("%c ██████╗ ██╗  ██╗ ██████╗ ███████╗██╗   ██╗███████╗\n%c██╔═████╗╚██╗██╔╝██╔════╝ ██╔════╝██║   ██║██╔════╝\n%c██║██╔██║ ╚███╔╝ ██║  ███╗███████╗██║   ██║███████╗\n%c████╔╝██║ ██╔██╗ ██║   ██║╚════██║██║   ██║╚════██║\n%c╚██████╔╝██╔╝ ██╗╚██████╔╝███████║╚██████╔╝███████║\n%c ╚═════╝ ╚═╝  ╚═╝ ╚═════╝ ╚══════╝ ╚═════╝ ╚══════╝", "color: #fde047; font-weight: bold;", "color: #fde047; font-weight: bold;", "color: #fde047; font-weight: bold;", "color: #fde047; font-weight: bold;", "color: #fde047; font-weight: bold;", "color: #fde047; font-weight: bold;");

        // ── Timed page mutation ──
        let idleTime = 0;
        setInterval(() => {
          idleTime++;
          if (idleTime === 60) {
            document.querySelectorAll('.brutal-card, .project-card, .ascii-art, .curl-box').forEach((el, i) => {
              const colors = ['#fde047', '#86efac', '#d8b4fe', '#93c5fd', '#fca5a5', '#fdba74'];
              (el as HTMLElement).style.filter = `drop-shadow(4px 4px 0 ${colors[i % colors.length]})`;
              (el as HTMLElement).style.transition = 'filter 1.5s ease';
            });
            console.log("%c🌈 60 seconds. I'm just going to make things colorful now.", "font-size:12px;color:#d8b4fe;");
          }
          if (idleTime === 120) {
            const msg = document.createElement('div');
            msg.style.cssText = 'position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:black;color:white;border:3px solid black;border-radius:8px;padding:8px 20px;font-family:"Courier New",monospace;font-size:12px;font-weight:700;z-index:9998;opacity:0.5;animation:toastIn 0.3s ease-out;';
            msg.textContent = "you can leave now. or don't. i'm not your parent.";
            document.body.appendChild(msg);
            setTimeout(() => { msg.style.opacity = '0'; msg.style.transition = 'opacity 1s'; }, 5000);
          }
        }, 1000);

        document.addEventListener('mousemove', () => { idleTime = 0; });
        document.addEventListener('keydown', () => { idleTime = 0; });
        document.addEventListener('scroll', () => { idleTime = 0; });
        document.addEventListener('click', () => { idleTime = 0; });
      }

    </script>
  </body>
</html>
