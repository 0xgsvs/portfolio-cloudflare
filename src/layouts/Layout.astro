---
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import '../styles/global.css';

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description || "Venkat Sundaraneedi — Rust & Blockchain Developer"} />
    <title>{title || "Venkat Sundaraneedi | Portfolio"}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <div class="container">
      <Header />
      <slot />
      <Footer />
    </div>
    <script>
      console.log(
        "%c██╗   ██╗███████╗███╗   ██╗██╗  ██╗ █████╗ ████████╗\n%c██║   ██║██╔════╝████╗  ██║██║ ██╔╝██╔══██╗╚══██╔══╝\n%c██║   ██║█████╗  ██╔██╗ ██║█████╔╝ ███████║   ██║   \n%c╚██╗ ██╔╝██╔══╝  ██║╚██╗██║██╔═██╗ ██╔══██║   ██║   \n%c ╚████╔╝ ███████╗██║ ╚████║██║  ██╗██║  ██║   ██║   \n%c  ╚═══╝  ╚══════╝╚═╝  ╚═══╝╚═╝  ╚═╝╚═╝  ╚═╝   ╚═╝   ",
        "color: #fde047; font-weight: bold;",
        "color: #fde047; font-weight: bold;",
        "color: #fde047; font-weight: bold;",
        "color: #fde047; font-weight: bold;",
        "color: #fde047; font-weight: bold;",
        "color: #fde047; font-weight: bold;"
      );
      console.log("%c👋 You're poking around the console. I like that.", "font-size: 14px; font-weight: bold; color: black;");
      console.log("%c💼 Rust & Blockchain Developer | Solana Ecosystem", "font-size: 12px; color: #666;");
      console.log("%c📧 venkat.subrahmanyam.34@gmail.com", "font-size: 12px; color: #666;");
      console.log("%c🐙 github.com/0xgsvs", "font-size: 12px; color: #666;");
      console.log("%c💡 Try typing 'matrix()' or 'konami()' for more surprises...", "font-size: 11px; color: #999; font-style: italic;");

      // ── Konami Code (↑↑↓↓←→←→BA) ──
      const KONAMI = ["ArrowUp","ArrowUp","ArrowDown","ArrowDown","ArrowLeft","ArrowRight","ArrowLeft","ArrowRight","b","a"];
      let konamiPos = 0;
      let konamiDone = false;
      document.addEventListener("keydown", (e) => {
        if (konamiDone) return;
        if (e.key === KONAMI[konamiPos]) {
          konamiPos++;
          if (konamiPos === KONAMI.length) {
            konamiDone = true;
            konamiPos = 0;
            document.body.classList.add("konami-activated");
            // Glitch the page briefly
            document.body.style.transform = "rotate(1deg)";
            document.body.style.transition = "transform 0.08s";
            setTimeout(() => { document.body.style.transform = "rotate(-1deg)"; }, 80);
            setTimeout(() => { document.body.style.transform = "rotate(0deg)"; }, 160);
            // Toast
            const toast = document.createElement("div");
            toast.className = "konami-toast";
            toast.textContent = "⬆⬆⬇⬇⬅➡⬅➡🅱🅰 — HACKER MODE UNLOCKED";
            document.body.appendChild(toast);
            setTimeout(() => toast.remove(), 3000);
            console.log("%c🎮 KONAMI CODE ACTIVATED — 30 lives granted", "font-size:16px;color:#86efac;font-weight:bold;");
            console.log("%cTry 'matrix()' in console or press ` (backtick) for terminal", "font-size:12px;color:#666;");
          }
        } else {
          konamiPos = 0;
        }
      });
      // Expose matrix() as a global for console use
      (window as any).matrix = () => document.body.classList.toggle("matrix-mode");
      (window as any).konami = () => { konamiDone = false; console.log("Konami code reset. Try again!"); };
    </script>
  </body>
</html>
