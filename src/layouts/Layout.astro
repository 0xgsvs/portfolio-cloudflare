---
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import TerminalOverlay from '../components/generic/TerminalOverlay.astro';
import CompileScreen from '../components/generic/CompileScreen.astro';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
// Tailwind temporarily disabled — its Vite plugin drops global CSS

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <meta name="description" content={description || "Venkat Sundaraneedi — Rust & Blockchain Developer"} />
    <title>{title || "Venkat Sundaraneedi | Portfolio"}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <ClientRouter />
    <style is:inline>
      ::-webkit-scrollbar{width:22px;background-color:#fff}
      ::-webkit-scrollbar-track{background:linear-gradient(45deg,#000 25%,transparent 25%,transparent 75%,#000 75%,#000),linear-gradient(45deg,#000 25%,transparent 25%,transparent 75%,#000 75%,#000);background-color:#fff;background-size:4px 4px;background-position:0 0,2px 2px;width:10px;border-left:3px solid #000}
      ::-webkit-scrollbar-thumb{width:20px;box-sizing:content-box;background-color:#fff;border:2px solid #000;border-right:none}
      ::-webkit-scrollbar-thumb:hover{background:#fde047}
      ::-webkit-scrollbar-button:horizontal:start:decrement,::-webkit-scrollbar-button:horizontal:end:increment,::-webkit-scrollbar-button:vertical:start:decrement,::-webkit-scrollbar-button:vertical:end:increment{display:block}
      ::-webkit-scrollbar-button:vertical:start{background-image:url("data:image/svg+xml;charset=utf-8,%3Csvg width='22' height='24' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath fill='%23fff' stroke='%23000' d='M.5.5h21v22.375H.5z'/%3E%3Cpath fill='%23000' d='M1 23h20v-2H1zM1.375 12.375h5.5V11h-5.5zM6.875 17.875h6.875V16.5H6.875zM6.875 17.875v-5.5H5.5v5.5zM9.625 5.5V4.125H8.25V5.5zM11 4.125V2.75H9.625v1.375zM19.25 12.375V11h-1.375v1.375zM17.875 11V9.625H16.5V11zM16.5 9.625V8.25h-1.375v1.375zM15.125 8.25V6.875H13.75V8.25zM13.75 6.875V5.5h-1.375v1.375zM12.375 5.5V4.125H11V5.5zM8.25 6.875V5.5H6.875v1.375zM6.875 8.25V6.875H5.5V8.25zM5.5 9.625V8.25H4.125v1.375zM4.125 11V9.625H2.75V11z'/%3E%3Cpath fill='%23000' d='M2.75 12.375V11H1.375v1.375zM15.125 17.875v-5.5H13.75v5.5zM13.75 12.375h5.5V11h-5.5z'/%3E%3C/svg%3E");background-repeat:no-repeat;height:23.38px}
      ::-webkit-scrollbar-button:vertical:start:active{background-image:url("data:image/svg+xml;charset=utf-8,%3Csvg width='22' height='24' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath fill='%23fde047' stroke='%23000' d='M.5.5h21v22.38H.5z'/%3E%3Cpath fill='%23000' d='M1 23.005h20v-2H1zM1.375 12.378h5.5v-1.375h-5.5zM6.875 17.879h6.875V6.877H6.875zM6.875 17.879v-5.501H5.5v5.5zM9.625 5.501V4.126H8.25v1.375zM11 4.126V2.75H9.625v1.375zM19.25 12.378v-1.375h-1.375v1.375zM17.875 11.002V9.627H13.75v1.375zM16.5 9.627V8.252h-2.75v1.375zM15.125 8.252V6.877H13.75v1.375zM13.75 6.876V5.501h-1.375v1.375zM12.375 5.501V4.126h-2.75v1.375zM12.375 6.876V5.501h-5.5v1.375zM6.875 8.252V6.877H5.5v1.375zM6.875 9.627V8.252h-2.75v1.375zM6.875 11.002V9.627H2.75v1.375z'/%3E%3Cpath fill='%23000' d='M2.75 12.378v-1.375H1.375v1.375zM15.125 17.879v-5.501H13.75v5.5zM13.75 12.378h5.5v-1.375h-5.5z'/%3E%3C/svg%3E");background-repeat:no-repeat;height:23.38px}
      ::-webkit-scrollbar-button:vertical:end{background-image:url("data:image/svg+xml;charset=utf-8,%3Csvg width='22' height='24' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath fill='%23fff' stroke='%23000' d='M.5 22.875h21V.5H.5z'/%3E%3Cpath fill='%23000' d='M1 .375h20v2H1zM1.375 11h5.5v1.375h-5.5zM6.875 5.5h6.875v1.375H6.875zM6.875 5.5V11H5.5V5.5zM9.625 17.875v1.375H8.25v-1.375zM11 19.25v1.375H9.625V19.25zM19.25 11v1.375h-1.375V11zM17.875 12.375v1.375H16.5v-1.375zM16.5 13.75v1.375h-1.375V13.75zM15.125 15.125V16.5H13.75v-1.375zM13.75 16.5v1.375h-1.375V16.5zM12.375 17.875v1.375H11v-1.375zM8.25 16.5v1.375H6.875V16.5zM6.875 15.125V16.5H5.5v-1.375zM5.5 13.75v1.375H4.125V13.75zM4.125 12.375v1.375H2.75v-1.375z'/%3E%3Cpath fill='%23000' d='M2.75 11v1.375H1.375V11zM15.125 5.5V11H13.75V5.5zM13.75 11h5.5v1.375h-5.5z'/%3E%3C/svg%3E");background-repeat:no-repeat;height:23.38px}
      ::-webkit-scrollbar-button:vertical:end:active{background-image:url("data:image/svg+xml;charset=utf-8,%3Csvg width='22' height='24' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath fill='%23fde047' stroke='%23000' d='M.5 22.88h21V.5H.5z'/%3E%3Cpath fill='%23000' d='M1 .375h20v2H1zM1.375 11.002h5.5v1.375h-5.5zM6.875 5.501h6.875v11.002H6.875zM6.875 5.501v5.501H5.5v-5.5zM9.625 17.879v1.375H8.25v-1.375zM11 19.254v1.375H9.625v-1.375zM19.25 11.002v1.375h-1.375v-1.375zM17.875 12.378v1.375H13.75v-1.375zM16.5 13.753v1.375h-2.75v-1.375zM15.125 15.128v1.375H13.75v-1.375zM13.75 16.503v1.375h-1.375v-1.375zM12.375 17.879v1.375h-2.75v-1.375zM12.375 16.503v1.375h-5.5v-1.375zM6.875 15.128v1.375H5.5v-1.375zM6.875 13.753v1.375h-2.75v-1.375zM6.875 12.378v1.375H2.75v-1.375z'/%3E%3Cpath fill='%23000' d='M2.75 11.002v1.375H1.375v-1.375zM15.125 5.501v5.501H13.75v-5.5zM13.75 11.002h5.5v1.375h-5.5z'/%3E%3C/svg%3E");background-repeat:no-repeat;height:23.38px}
    </style>
  </head>
  <body>
    <CompileScreen />
    <div class="container">
      <Header />
      <slot />
      <Footer />
    </div>
    <TerminalOverlay />
    <script>
      // Guard: only run setup once (window persists across ClientRouter navigations)
      if (!(window as any).__portfolioSetup) {
        (window as any).__portfolioSetup = true;

        console.log(
          "%c██╗   ██╗███████╗███╗   ██╗██╗  ██╗ █████╗ ████████╗\\n%c██║   ██║██╔════╝████╗  ██║██║ ██╔╝██╔══██╗╚══██╔══╝\\n%c██║   ██║█████╗  ██╔██╗ ██║█████╔╝ ███████║   ██║   \\n%c╚██╗ ██╔╝██╔══╝  ██║╚██╗██║██╔═██╗ ██╔══██║   ██║   \\n%c ╚████╔╝ ███████╗██║ ╚████║██║  ██╗██║  ██║   ██║   \\n%c  ╚═══╝  ╚══════╝╚═╝  ╚═══╝╚═╝  ╚═╝╚═╝  ╚═╝   ╚═╝   ",
          "color: #fde047; font-weight: bold;",
          "color: #fde047; font-weight: bold;",
          "color: #fde047; font-weight: bold;",
          "color: #fde047; font-weight: bold;",
          "color: #fde047; font-weight: bold;",
          "color: #fde047; font-weight: bold;"
        );
        console.log("%c👋 You're poking around the console. I like that.", "font-size: 14px; font-weight: bold; color: black;");
        console.log("%c💼 Rust & Blockchain Developer | Solana Ecosystem", "font-size: 12px; color: #666;");
        console.log("%c📧 venkat.subrahmanyam.34@gmail.com", "font-size: 12px; color: #666;");
        console.log("%c🐙 github.com/0xgsvs", "font-size: 12px; color: #666;");
        console.log("%c💡 Try typing 'matrix()' or 'konami()' for more surprises...", "font-size: 11px; color: #999; font-style: italic;");

        // ── Konami Code (↑↑↓↓←→←→BA) ──
        const KONAMI = ["ArrowUp","ArrowUp","ArrowDown","ArrowDown","ArrowLeft","ArrowRight","ArrowLeft","ArrowRight","b","a"];
        let konamiPos = 0;
        let konamiDone = false;
        document.addEventListener("keydown", (e) => {
          if (konamiDone) return;
          if (e.key === KONAMI[konamiPos]) {
            konamiPos++;
            if (konamiPos === KONAMI.length) {
              konamiDone = true;
              konamiPos = 0;
              document.body.classList.add("konami-activated");
              document.body.style.transform = "rotate(1deg)";
              document.body.style.transition = "transform 0.08s";
              setTimeout(() => { document.body.style.transform = "rotate(-1deg)"; }, 80);
              setTimeout(() => { document.body.style.transform = "rotate(0deg)"; }, 160);
              const toast = document.createElement("div");
              toast.className = "konami-toast";
              toast.textContent = "⬆⬆⬇⬇⬅➡⬅➡🅱🅰 — HACKER MODE UNLOCKED";
              document.body.appendChild(toast);
              setTimeout(() => toast.remove(), 3000);
              console.log("%c🎮 KONAMI CODE ACTIVATED — 30 lives granted", "font-size:16px;color:#86efac;font-weight:bold;");
              console.log("%cTry 'matrix()' in console or press ` (backtick) for terminal", "font-size:12px;color:#666;");
            }
          } else {
            konamiPos = 0;
          }
        });

        // ── Timed page mutation ──
        let idleTime = 0;
        setInterval(() => {
          idleTime++;
          if (idleTime === 60) {
            document.querySelectorAll('.brutal-card, .project-card, .ascii-art, .curl-box').forEach((el, i) => {
              const colors = ['#fde047', '#86efac', '#d8b4fe', '#93c5fd', '#fca5a5', '#fdba74'];
              (el as HTMLElement).style.filter = `drop-shadow(4px 4px 0 ${colors[i % colors.length]})`;
              (el as HTMLElement).style.transition = 'filter 1.5s ease';
            });
            console.log("%c🌈 60 seconds. I'm just going to make things colorful now.", "font-size:12px;color:#d8b4fe;");
          }
          if (idleTime === 120) {
            const msg = document.createElement('div');
            msg.style.cssText = 'position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:black;color:white;border:3px solid black;border-radius:8px;padding:8px 20px;font-family:"Courier New",monospace;font-size:12px;font-weight:700;z-index:9998;opacity:0.5;animation:toastIn 0.3s ease-out;';
            msg.textContent = "you can leave now. or don't. i'm not your parent.";
            document.body.appendChild(msg);
            setTimeout(() => { msg.style.opacity = '0'; msg.style.transition = 'opacity 1s'; }, 5000);
          }
        }, 1000);

        document.addEventListener('mousemove', () => { idleTime = 0; });
        document.addEventListener('keydown', () => { idleTime = 0; });
        document.addEventListener('scroll', () => { idleTime = 0; });
        document.addEventListener('click', () => { idleTime = 0; });
      }

      // Re-expose globals on every navigation (inline script re-executes, window persists)
      (window as any).konami = () => { console.log("Konami code reset. Try again!"); };
    </script>
  </body>
</html>
