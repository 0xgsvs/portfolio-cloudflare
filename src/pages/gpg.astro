---
import Layout from '../layouts/Layout.astro';

// Placeholder GPG key — replace with your real one.
const gpgKey = `-----BEGIN PGP PUBLIC KEY BLOCK-----

mQINBGabcdef1234567890ABCDEFGhijklmnopqrstuvwxyz
ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvw
xyz0123456789+/ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefg
hijklmnopqrstuvwxyz0123456789+/ABCDEFGHIJKLMNOPQ
RSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/AB
CDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxy
z0123456789+/ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghij
klmnopqrstuvwxyz0123456789+/ABCDEFGHIJKLMNOPQRSTU
=ABCD
-----END PGP PUBLIC KEY BLOCK-----`;

const shortId = "ABCD 1234 EFGH 5678";
---

<Layout title="GPG Key | Venkat Sundaraneedi" description="GPG public key for Venkat Sundaraneedi">
  <section class="section">
    <div class="section-head">
      <span class="section-label">Security</span>
      <h1 class="section-title">GPG public key</h1>
    </div>

    <div class="brutal-card card-yellow" style="max-width:720px;">
      <h2>Key info</h2>
      <table class="key-table">
        <tr><th scope="row">Key ID</th><td class="mono">{shortId}</td></tr>
        <tr><th scope="row">Type</th><td>RSA 4096 / Ed25519</td></tr>
        <tr><th scope="row">Email</th><td class="mono">venkat.subrahmanyam.34@gmail.com</td></tr>
        <tr><th scope="row">Fingerprint</th><td class="mono small">ABCD 1234 EFGH 5678 IJKL 9012 MNOP 3456 QRST 7890</td></tr>
      </table>
    </div>

    <div class="brutal-card card-purple" style="max-width:720px;">
      <h2>Import my key</h2>
      <pre class="block-pre">
# From the web
curl -L https://0xgsvs.dev/gpg.txt | gpg --import

# From keyserver
gpg --keyserver keys.gnupg.net --recv-keys ABCD1234EFGH5678</pre>
    </div>

    <div class="brutal-card" style="max-width:720px;">
      <h2>Public key block</h2>
      <pre class="key-block">{gpgKey}</pre>
      <p class="key-warning">
        <strong>This is a placeholder key.</strong> Replace it with your real key before publishing.
        <a href="https://www.gnupg.org/gph/en/manual/c14.html">Learn how to generate one →</a>
      </p>
    </div>
  </section>
</Layout>

<style>
  .key-table {
    font-size: var(--text-sm);
    border-collapse: collapse;
    width: 100%;
    table-layout: fixed;
  }
  .key-table th,
  .key-table td {
    text-align: start;
    padding: var(--space-2) var(--space-3) var(--space-2) 0;
    vertical-align: top;
    overflow-wrap: anywhere;
  }
  .key-table th {
    width: 7.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .mono {
    font-family: var(--font-mono);
    font-weight: 700;
  }
  .small {
    font-size: var(--text-xs);
  }
  @media (max-width: 480px) {
    .key-table th,
    .key-table td {
      display: block;
      width: auto;
      padding-inline-end: 0;
    }
    .key-table th {
      padding-top: var(--space-3);
      padding-bottom: 0;
    }
  }
  .block-pre {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: 1.6;
    overflow-x: auto;
    background: var(--white);
    border: 2px solid var(--line);
    padding: var(--space-3);
  }
  .key-block {
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.5;
    overflow-x: auto;
    white-space: pre-wrap;
    word-break: break-all;
  }
  .key-warning {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    color: var(--ink-2);
  }
  .key-warning a {
    color: var(--ink);
  }
</style>
