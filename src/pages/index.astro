---
import Layout from '../layouts/Layout.astro';
import { projects, stackGroups, socialLinks, kindLabels } from '../data/projects';
import PixelTerminal from '../components/generic/PixelTerminal.astro';
import PixelRust from '../components/generic/PixelRust.astro';
import PixelSolana from '../components/generic/PixelSolana.astro';
import PixelGithub from '../components/generic/PixelGithub.astro';
import PixelEmail from '../components/generic/PixelEmail.astro';
import PixelPortrait from '../components/generic/PixelPortrait.astro';
import PixelCommitGraph from '../components/generic/PixelCommitGraph.astro';
import MobileSocials from '../components/home/MobileSocials.astro';

const socialIconMap: Record<string, any> = { github: PixelGithub, email: PixelEmail };

const [lead, ...rest] = projects;
---

<Layout title="Venkat Sundaraneedi | Rust & Blockchain Dev" description="Rust & Blockchain developer. Building on Solana, living in Arch/Nix, learning Zig.">
  <!-- ===== IDENTITY ===== -->
  <section class="hero">
    <div class="hero-grid">
      <div>
        <p class="hero-role">Rust &amp; blockchain developer</p>
        <h1><span class="hero-name">Venkat Sundaraneedi</span></h1>
        <p class="tagline">
          <span id="typewriter" class="typewriter-cursor"></span>
        </p>
        <div class="hero-actions">
          <a class="btn btn--accent" href="#work">See the work</a>
          <a class="btn" href="/contact">Contact</a>
        </div>

        <ul class="dev-toolkit">
          <li class="dev-tool">
            <span class="tool-icon"><PixelTerminal /></span>
            <span class="tool-label">Terminal</span>
          </li>
          <li class="dev-tool">
            <span class="tool-icon"><PixelRust /></span>
            <span class="tool-label">Rust</span>
          </li>
          <li class="dev-tool">
            <span class="tool-icon"><PixelSolana /></span>
            <span class="tool-label">Solana</span>
          </li>
        </ul>

        <div class="curl-box">
          <code id="curl-command">$ curl -L https://0xgsvs.dev/contact.txt</code>
          <button class="copy-btn" id="curl-copy" type="button">COPY</button>
        </div>
        <p id="curl-status" class="visually-hidden" role="status" aria-live="polite"></p>
      </div>

      <aside class="rail" aria-label="Live activity">
        <span class="rail-label">// system</span>
        <div class="rail-portrait">
          <PixelPortrait />
          <p class="rail-hint">Hover the portrait for diagnostics.</p>
        </div>
        <PixelCommitGraph />
      </aside>
    </div>

    <MobileSocials />
  </section>

  <!-- ===== WORK ===== -->
  <section id="work" class="section">
    <div class="section-head">
      <span class="section-label">01 / Work</span>
      <h2 class="section-title">Selected projects</h2>
      <p class="section-note">Ordered by weight, not by date. Every entry links to its source.</p>
    </div>

    <ol class="work">
      <li class={`work-item work-item--lead work-item--${lead.kind}`}>
        <div class="work-index">01</div>
        <div class="work-body">
          <h3>{lead.title}</h3>
          <div class="work-meta">
            <span class={`kind kind--${lead.kind}`}>{kindLabels[lead.kind]}</span>
            <div class="tags">
              {lead.tags.map((tag) => <span class="tag">{tag}</span>)}
            </div>
          </div>
          <p class="work-desc">{lead.description}</p>
          <div class="work-links">
            {lead.codeUrl && <a href={lead.codeUrl} target="_blank" rel="noopener noreferrer">Source ↗</a>}
            {lead.demoUrl && <a href={lead.demoUrl} target="_blank" rel="noopener noreferrer">Demo ↗</a>}
          </div>
        </div>
      </li>

      {
        rest.map((project, i) => (
          <li class={`work-item work-item--${project.kind}`}>
            <div class="work-index">{String(i + 2).padStart(2, '0')}</div>
            <div class="work-body">
              <h3>{project.title}</h3>
              <div class="work-meta">
                <span class={`kind kind--${project.kind}`}>{kindLabels[project.kind]}</span>
                <div class="tags">
                  {project.tags.map((tag) => <span class="tag">{tag}</span>)}
                </div>
              </div>
              <p class="work-desc">{project.description}</p>
              <div class="work-links">
                {project.codeUrl && <a href={project.codeUrl} target="_blank" rel="noopener noreferrer">Source ↗</a>}
                {project.demoUrl && <a href={project.demoUrl} target="_blank" rel="noopener noreferrer">Demo ↗</a>}
              </div>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- ===== STACK ===== -->
  <section id="stack" class="section">
    <div class="section-head">
      <span class="section-label">02 / Stack</span>
      <h2 class="section-title">Tools I reach for</h2>
    </div>

    <div>
      {
        stackGroups.map((group) => (
          <div class="stack">
            <div class="stack-term">{group.term}</div>
            <ul class="stack-items">
              {group.items.map((item) => (
                <li class={`stack-item stack-item--${group.variant}`}>{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ===== CONTACT ===== -->
  <section id="contact" class="section">
    <div class="section-head">
      <span class="section-label">03 / Contact</span>
      <h2 class="section-title">Get in touch</h2>
      <p class="section-note">Terminal users can pull the vCard and GPG key straight from the domain.</p>
    </div>

    <div class="contact-grid">
      {
        socialLinks.map((link) => {
          const IconComponent = socialIconMap[link.icon];
          return (
            <a
              href={link.url}
              class={`contact-card card-${link.color}`}
              target={link.url.startsWith('mailto:') ? undefined : '_blank'}
              rel="noopener noreferrer"
            >
              <span class="contact-icon">{IconComponent && <IconComponent />}</span>
              <span>
                <span class="contact-label">{link.name}</span>
                <span class="contact-detail">{link.detail}</span>
              </span>
            </a>
          );
        })
      }
    </div>
  </section>

  <!-- ===== COLOPHON ===== -->
  <div class="colophon">
    <div class="ascii-art">
      <pre> ██████╗ ██╗  ██╗ ██████╗ ███████╗██╗   ██╗███████╗
██╔═████╗╚██╗██╔╝██╔════╝ ██╔════╝██║   ██║██╔════╝
██║██╔██║ ╚███╔╝ ██║  ███╗███████╗██║   ██║███████╗
████╔╝██║ ██╔██╗ ██║   ██║╚════██║██║   ██║╚════██║
╚██████╔╝██╔╝ ██╗╚██████╔╝███████║╚██████╔╝███████║
 ╚═════╝ ╚═╝  ╚═╝ ╚═════╝ ╚══════╝ ╚═════╝ ╚══════╝

Rust & Blockchain Developer | Solana Ecosystem
Arch/Nix Dual Boot | Terminal Enthusiast

📧 venkat.subrahmanyam.34@gmail.com
🐙 github.com/0xgsvs</pre>
    </div>

    <div class="screen-too-small">
      <pre>┌──────────────────────────────────┐
│       SCREEN TOO SMALL           │
│                                  │
│     ┌───┐    ┌───┐    ┌───┐      │
│     │ ▼ │    │ ▼ │    │ ▼ │      │
│     └───┘    └───┘    └───┘      │
│       ↑        ↑        ↑        │
│     GET A    GET A     GET A     │
│    BIGGER   BIGGER    BIGGER     │
│    SCREEN   SCREEN    SCREEN     │
│                                  │
│ Terminal devs use real monitors  │
└──────────────────────────────────┘</pre>
    </div>
  </div>
</Layout>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  // Typewriter — skipped entirely for reduced-motion users
  function startTypewriter() {
    const el = document.getElementById('typewriter');
    if (!el) return;
    const text = "Rust & Blockchain developer. Arch/Nix dual boot. Building in the Solana ecosystem.";

    if (reduceMotion.matches) {
      el.textContent = text;
      el.classList.remove('typewriter-cursor');
      el.classList.add('typewriter-done');
      return;
    }

    el.textContent = '';
    el.classList.add('typewriter-cursor');
    el.classList.remove('typewriter-done');
    let i = 0;
    function type() {
      if (i < text.length) {
        el.textContent = text.slice(0, i + 1);
        i++;
        setTimeout(type, 40);
      } else {
        el.classList.remove('typewriter-cursor');
        el.classList.add('typewriter-done');
      }
    }
    type();
  }
  startTypewriter();
  document.addEventListener('astro:page-load', startTypewriter);

  // Copy button — scripted, with an announced result
  function bindCopyButton() {
    const copyBtn = document.getElementById('curl-copy') as HTMLButtonElement | null;
    const copyStatus = document.getElementById('curl-status');
    if (!copyBtn || copyBtn.dataset.bound) return;
    copyBtn.dataset.bound = 'true';
    copyBtn.addEventListener('click', async () => {
      const command = 'curl -L https://0xgsvs.dev/contact.txt';
      try {
        await navigator.clipboard.writeText(command);
        copyBtn.textContent = 'COPIED';
        copyBtn.classList.add('copied');
        if (copyStatus) copyStatus.textContent = 'Command copied to clipboard.';
      } catch {
        copyBtn.textContent = 'COPY FAILED';
        if (copyStatus) copyStatus.textContent = 'Copy failed. Select the command and copy it manually.';
      }
      setTimeout(() => {
        copyBtn.textContent = 'COPY';
        copyBtn.classList.remove('copied');
      }, 2000);
    });
  }
  bindCopyButton();
  document.addEventListener('astro:page-load', bindCopyButton);
</script>
