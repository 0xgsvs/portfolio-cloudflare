---
import Manual from "../layouts/Manual.astro";
import ActivityTrace from "../components/ActivityTrace.astro";
import CommandLine from "../components/CommandLine.astro";
import { site, trana, repos, planned, tools, homeSections } from "../data/site";
import { posts } from "../data/posts";
import { formatDate } from "../utils/date";
---

<Manual
  title="Venkat Sundaraneedi — Rust & Solana systems engineer"
  description={site.description}
  manTitle="Venkat"
  manNumber="1"
  tagline={site.tagline}
  index={homeSections}
  hasAside
>
  <Fragment slot="actions">
    <a class="action action--solid" href="/cv-placeholder.pdf" download="venkat-cv.pdf">
      Download CV <span class="arrow" aria-hidden="true">↓</span>
    </a>
    <a class="action" href="/contact">Contact</a>
    <a class="action" href={site.github} target="_blank" rel="noopener noreferrer">
      GitHub <span class="arrow" aria-hidden="true">↗</span>
    </a>
  </Fragment>

  <Fragment slot="aside">
    <div class="hero-proof">
      <h2 class="proof-title">
        <a href={trana.repo} target="_blank" rel="noopener noreferrer">{trana.title}</a>
      </h2>
      <p class="proof-status">Current build · devnet</p>
      <p class="proof-desc">
        Parametric freight-delay indemnity on Solana. USDC pools, permissionless settlement, fully
        collateralised.
      </p>
      <dl class="facts">
        <div>
          <dt>Program</dt>
          <dd class="break"><code translate="no">4BtUosFfNUySEGAGspfjvStCzLzqSRdfoc4Z3Z1uqGJs</code></dd>
        </div>
        <div>
          <dt>Evidence</dt>
          <dd>38 LiteSVM tests · devnet e2e</dd>
        </div>
      </dl>
      <div class="work-links">
        <a href={trana.repo} target="_blank" rel="noopener noreferrer">Repository ↗</a>
        <a href={trana.explorer} target="_blank" rel="noopener noreferrer">Explorer ↗</a>
      </div>
      <ActivityTrace />
    </div>
  </Fragment>

  <section class="section" id="name">
    <div class="section-head">
      <span class="section-num">01</span>
      <h2>Name</h2>
    </div>
    <p class="lede">
      Venkat Sundaraneedi — Rust and Solana systems engineer. Building Freight Delay, a protocol
      that settles freight-delay insurance in the open.
    </p>
  </section>

  <section class="section" id="description">
    <div class="section-head">
      <span class="section-num">02</span>
      <h2>Description</h2>
    </div>
    <div class="prose">
      <p>
        I work close to the constraint: Rust programs, the Solana runtime, Anchor accounts and
        invariants, Nix-built environments, and the terminal tools that keep the loop short. The
        default is to make the invariant explicit, test it until it is boring, then make the next
        one.
      </p>
      <p>
        {trana.parent} lives under ChaosCore Labs. It ships to devnet, keeps every payout fully
        collateralised, and runs its tests in-process against the same binary it deploys.
      </p>
      <p>
        The rest of the setup is Linux: Arch as the daily driver, NixOS as the second boot, and
        dotfiles kept in public. I write when a problem deserves a record.
      </p>
      <h3 class="subhead">Stack</h3>
      <ul class="tool-list">
        {tools.map((group) => (
          <li><strong>{group.role}</strong> {group.items.join(" · ")}</li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" id="work">
    <div class="section-head">
      <span class="section-num">03</span>
      <h2>Work</h2>
      <p class="section-deck">Shipped work links to source. Planned work is labelled, not dressed as shipped.</p>
    </div>

    <article class="work-entry">
      <div class="work-side">
        Shipped · 2026
        <span class="status status--live">Devnet live</span>
      </div>
      <div>
        <h3 class="work-title">
          <a href={trana.repo} target="_blank" rel="noopener noreferrer">{trana.title} →</a>
        </h3>
        <p class="work-desc">{trana.description}</p>
        <div class="work-links">
          <a href={trana.repo} target="_blank" rel="noopener noreferrer">Source</a>
          <a href={trana.explorer} target="_blank" rel="noopener noreferrer">Devnet program</a>
        </div>
        <dl class="facts">
          {trana.facts.map((fact) => (
            <div>
              <dt>{fact.key}</dt>
              <dd class={fact.key === "Program" ? "break" : ""}>
                {fact.key === "Program" ? <code translate="no">{fact.value}</code> : fact.value}
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </article>

    <ul class="repo-list" aria-label="Public repositories">
      {repos.map((repo) => (
        <li>
          <span>
            <a href={repo.url} target="_blank" rel="noopener noreferrer">{repo.name} ↗</a>
            <span class="muted small"> — {repo.description}</span>
          </span>
          <span class="lang">{repo.lang}</span>
        </li>
      ))}
    </ul>

    <div class="planned">
      <p class="planned-title">On the bench · planned, not shipped</p>
      <ul>
        {planned.map((item) => (
          <li><strong>{item.title}</strong><span>{item.note}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" id="writing">
    <div class="section-head">
      <span class="section-num">04</span>
      <h2>Writing</h2>
      <p class="section-deck">I write when there is something to record, not on a schedule.</p>
    </div>
    <ol class="entries">
      {posts.map((post) => (
        <li class="entry">
          <a href={`/writing/${post.slug}`}>
            <time datetime={post.date}>{formatDate(post.date)}</time>
            <span class="entry-title">{post.title}</span>
            <span class="entry-arrow" aria-hidden="true">↗</span>
            <span class="entry-excerpt">{post.excerpt}</span>
          </a>
        </li>
      ))}
    </ol>
    <p><a class="more" href="/writing">All writing</a></p>
  </section>

  <section class="section" id="examples">
    <div class="section-head">
      <span class="section-num">05</span>
      <h2>Examples</h2>
      <p class="section-deck">The site is usable from a shell, not only a browser.</p>
    </div>
    <CommandLine label="vCard" command="curl -L https://0xgsvs.dev/contact.txt" />
    <CommandLine label="Freight Delay" command="git clone https://github.com/ChaosCore-labs/Trana_Protocol.git" />
  </section>

  <section class="section" id="files">
    <div class="section-head">
      <span class="section-num">06</span>
      <h2>Files</h2>
    </div>
    <dl class="files">
      <div>
        <dt>CV</dt>
        <dd><a href="/cv-placeholder.pdf" download="venkat-cv.pdf">venkat-cv.pdf</a></dd>
        <span class="placeholder">Placeholder</span>
      </div>
      <div>
        <dt>vCard</dt>
        <dd><a href="/contact.txt">contact.txt</a></dd>
        <span class="placeholder">Plain text</span>
      </div>
      <div>
        <dt>Source</dt>
        <dd><a href={site.github} target="_blank" rel="noopener noreferrer">github.com/0xgsvs</a></dd>
        <span class="placeholder">Public</span>
      </div>
      <div>
        <dt>Email</dt>
        <dd><a href={`mailto:${site.email}`} translate="no">{site.email}</a></dd>
        <span class="placeholder">Direct</span>
      </div>
    </dl>
  </section>

  <section class="section" id="see-also">
    <div class="section-head">
      <span class="section-num">07</span>
      <h2>See also</h2>
    </div>
    <ul class="see-also">
      <li><a href="/writing"><span>writing(7)</span><span>{posts.length} entries</span></a></li>
      <li><a href="/tools"><span>tools(1)</span><span>daily setup</span></a></li>
      <li><a href="/contact"><span>contact(1)</span><span>email first</span></a></li>
      <li><a href="/guestbook"><span>guestbook(8)</span><span>leave a trace</span></a></li>
      <li><a href={site.github} target="_blank" rel="noopener noreferrer"><span>github.com/0xgsvs</span><span>source ↗</span></a></li>
    </ul>
  </section>

  <section class="section" id="bugs">
    <div class="section-head">
      <span class="section-num">08</span>
      <h2>Bugs</h2>
      <p class="section-deck">Known limits, stated before you find them.</p>
    </div>
    <div class="prose">
      <ul>
        <li>The CV download is a labelled placeholder, not the real document.</li>
        <li>{trana.title} is on devnet, not mainnet.</li>
        <li>The {planned.length} projects on the bench have no repositories yet, so they have no source links.</li>
        <li>No GPG key is published. When there is a real one, it gets a real page.</li>
      </ul>
    </div>
  </section>

  <style>
    .hero-proof .activity {
      margin-top: 1.25rem;
    }
    .hero-proof .proof-desc {
      font-size: var(--text-sm);
    }
    .hero-proof .proof-status {
      margin-top: 0.35rem;
      font-size: var(--text-xs);
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--signal);
    }
    .hero-proof .proof-title {
      font-size: clamp(1.5rem, 2.4vw, 1.9rem);
    }
    .hero-proof .facts {
      margin-top: 0.9rem;
    }
    .hero-proof .work-links {
      margin-top: 0.75rem;
    }
    .subhead {
      margin: 1.75rem 0 0.75rem;
      font-family: var(--font-mono);
      font-size: var(--text-xs);
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--ink-3);
    }
    .tool-list {
      list-style: none;
      margin: 0;
      border-top: 1px solid var(--hair);
      max-width: 46rem;
    }
    .tool-list li {
      padding: 0.45rem 0;
      border-bottom: 1px solid var(--hair);
      font-size: var(--text-sm);
    }
    .tool-list strong {
      display: inline-block;
      min-width: 11rem;
      font-size: var(--text-xs);
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--ink-3);
    }
    .work-entry .facts {
      margin-top: 1rem;
      max-width: 38rem;
    }
    .more {
      display: inline-block;
      margin-top: 1rem;
      font-size: var(--text-xs);
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      text-decoration: none;
      border-bottom: 1px solid var(--ink);
    }
    .more:hover {
      color: var(--signal);
      border-bottom-color: var(--signal);
    }
    #examples .command + .command {
      margin-top: 1.25rem;
    }
  </style>
</Manual>
