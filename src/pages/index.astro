---
import Layout from '../layouts/Layout.astro';
import { projects, techStack, socialLinks } from '../data/projects';
import PixelTerminal from '../components/generic/PixelTerminal.astro';
import PixelRust from '../components/generic/PixelRust.astro';
import PixelSolana from '../components/generic/PixelSolana.astro';
import PixelGithub from '../components/generic/PixelGithub.astro';
import PixelEmail from '../components/generic/PixelEmail.astro';
import PixelChain from '../components/generic/PixelChain.astro';
import PixelFile from '../components/generic/PixelFile.astro';
import PixelChart from '../components/generic/PixelChart.astro';
import PixelPortrait from '../components/generic/PixelPortrait.astro';
import PixelCommitGraph from '../components/generic/PixelCommitGraph.astro';
import MobileSocials from '../components/home/MobileSocials.astro';

const iconMap: Record<string, any> = {
  chain: PixelChain,
  file: PixelFile,
  chart: PixelChart,
  github: PixelGithub,
  email: PixelEmail,
};
---

<Layout title="Venkat Sundaraneedi | Rust & Blockchain Dev" description="Rust & Blockchain developer. Building on Solana, living in Arch/Nix, learning Zig.">
  <!-- ===== HERO ===== -->
  <section class="hero">
    <h1>
      <span class="hero-name">VENKAT SUNDARANEEDI</span>
    </h1>
    <p class="tagline">
      <span id="typewriter" class="typewriter-cursor"></span>
    </p>
  </section>

  <!-- Mobile social links -->
  <MobileSocials />

  <!-- ===== CURL COMMAND ===== -->
  <div class="curl-box">
    <code>$ curl -L https://0xgsvs.dev/contact.txt</code>
    <button class="copy-btn" id="copy-btn" onclick="copyCurl()">COPY</button>
  </div>

  <!-- ===== DEV TOOLKIT ===== -->
  <section class="section">
    <h2 class="section-title">DEV TOOLKIT</h2>
    <div class="dev-toolkit">
      <div class="dev-tool">
        <div class="tool-icon">
          <PixelTerminal />
        </div>
        <div class="tool-label">Terminal</div>
      </div>
      <div class="dev-tool">
        <div class="tool-icon">
          <PixelRust />
        </div>
        <div class="tool-label">Rust</div>
      </div>
      <div class="dev-tool">
        <div class="tool-icon">
          <PixelSolana />
        </div>
        <div class="tool-label">Solana</div>
      </div>
    </div>
  </section>

  <!-- ===== PIXEL PORTRAIT ===== -->
  <div style="text-align:center;padding:20px 0;">
    <PixelPortrait />
    <p style="font-size:11px;opacity:0.4;margin-top:8px;font-family:'Courier New',monospace;">hover for diagnostics</p>
  </div>

  <!-- ===== PROJECTS ===== -->
  <section id="projects" class="section">
    <h2 class="section-title">FEATURED PROJECTS</h2>
    <div class="project-grid">
      {
        projects.map((project) => {
          const IconComponent = iconMap[project.icon];
          return (
            <div class={`project-card card-${project.color}`}>
              <div class="pixel-icon">
                {IconComponent && <IconComponent />}
              </div>
              <h3>{project.title}</h3>
              <p>{project.description}</p>
              <div class="tags">
                {project.tags.map((tag) => <span class="tag">{tag}</span>)}
              </div>
              <div class="links">
                {project.codeUrl && (
                  <a href={project.codeUrl} target="_blank" rel="noopener noreferrer">Code ↗</a>
                )}
                {project.demoUrl && (
                  <a href={project.demoUrl} target="_blank" rel="noopener noreferrer">Demo ↗</a>
                )}
              </div>
            </div>
          );
        })
      }
    </div>
  </section>

  <!-- ===== COMMIT GRAPH ===== -->
  <PixelCommitGraph />

  <!-- ===== TECH STACK ===== -->
  <section id="tech" class="section">
    <h2 class="section-title">TECH STACK</h2>
    <div class="tech-grid">
      {
        techStack.map((tech) => (
          <span class={`tech-tag card-${tech.color}`}>{tech.name}</span>
        ))
      }
    </div>
  </section>

  <!-- ===== ASCII ART / SCREEN TOO SMALL ===== -->
  <div class="ascii-art" id="ascii-art">
    <pre id="ascii-pre"> ██████╗ ██╗  ██╗ ██████╗ ███████╗██╗   ██╗███████╗
██╔═████╗╚██╗██╔╝██╔════╝ ██╔════╝██║   ██║██╔════╝
██║██╔██║ ╚███╔╝ ██║  ███╗███████╗██║   ██║███████╗
████╔╝██║ ██╔██╗ ██║   ██║╚════██║██║   ██║╚════██║
╚██████╔╝██╔╝ ██╗╚██████╔╝███████║╚██████╔╝███████║
 ╚═════╝ ╚═╝  ╚═╝ ╚═════╝ ╚══════╝ ╚═════╝ ╚══════╝

Rust & Blockchain Developer | Solana Ecosystem
Arch/Nix Dual Boot | Terminal Enthusiast

📧 venkat.subrahmanyam.34@gmail.com
🐙 github.com/0xgsvs</pre>
  </div>

  <div class="screen-too-small">
    <pre>┌──────────────────────────────────┐
│       SCREEN TOO SMALL           │
│                                  │
│     ┌───┐    ┌───┐    ┌───┐      │
│     │ ▼ │    │ ▼ │    │ ▼ │      │
│     └───┘    └───┘    └───┘      │
│       ↑        ↑        ↑        │
│     GET A    GET A     GET A     │
│    BIGGER   BIGGER    BIGGER     │
│    SCREEN   SCREEN    SCREEN     │
│                                  │
│ Terminal devs use real monitors  │
└──────────────────────────────────┘</pre>
  </div>

  <!-- ===== CONTACT ===== -->
  <section id="contact" class="section">
    <h2 class="section-title">GET IN TOUCH</h2>
    <div class="contact-grid">
      {
        socialLinks.map((link) => {
          const IconComponent = iconMap[link.icon];
          return (
            <a
              href={link.url}
              class={`contact-card card-${link.color}`}
              target={link.url.startsWith('mailto:') ? undefined : '_blank'}
              rel="noopener noreferrer"
            >
              <div class="contact-icon">
                {IconComponent && <IconComponent />}
              </div>
              <div class="contact-label">{link.name}</div>
              <div class="contact-detail">{link.detail}</div>
            </a>
          );
        })
      }
    </div>
  </section>
</Layout>

<script>
  // Typewriter effect
  const text = "Rust & Blockchain developer. Arch/Nix dual boot. Building in the Solana ecosystem.";
  const el = document.getElementById('typewriter');
  let i = 0;

  function type() {
    if (el && i < text.length) {
      el.textContent = text.slice(0, i + 1);
      i++;
      setTimeout(type, 40);
    } else if (el) {
      el.classList.remove('typewriter-cursor');
      el.classList.add('typewriter-done');
    }
  }
  type();

  // Copy curl command
  function copyCurl() {
    navigator.clipboard.writeText('curl -L https://0xgsvs.dev/contact.txt');
    const btn = document.getElementById('copy-btn');
    if (btn) {
      btn.textContent = 'COPIED!';
      btn.classList.add('copied');
      setTimeout(() => {
        btn.textContent = 'COPY';
        btn.classList.remove('copied');
      }, 2000);
    }
  }
  // Expose to global scope for onclick
  (window as any).copyCurl = copyCurl;

  // ── Rage-click counter on ASCII art ──
  const asciiArt = document.getElementById('ascii-art');
  const asciiPre = document.getElementById('ascii-pre');
  let asciiClicks = 0;
  let asciiTimeout: ReturnType<typeof setTimeout>;
  const messages = [
    "calm down, it's just ASCII",
    "ok keep going...",
    "you're persistent, I'll give you that",
    "almost there...",
    "🔥 YOU BROKE IT",
  ];

  if (asciiArt) {
    asciiArt.addEventListener('click', () => {
      asciiClicks++;
      clearTimeout(asciiTimeout);
      const msgIdx = Math.min(asciiClicks - 1, messages.length - 1);

      if (asciiClicks >= 10) {
        // Glitch out the ASCII art
        if (asciiPre) {
          asciiPre.style.animation = 'jitter 0.05s infinite linear alternate-reverse';
        }
        asciiArt.style.filter = 'drop-shadow(4px 4px 0 #fca5a5)';

        const toast = document.createElement('div');
        toast.style.cssText = 'position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:black;color:#fca5a5;border:3px solid #fca5a5;border-radius:8px;padding:12px 24px;font-family:"Courier New",monospace;font-weight:700;font-size:14px;z-index:9999;animation:toastIn 0.3s ease-out,toastOut 0.3s ease-in 2.7s forwards;';
        toast.textContent = messages[msgIdx];
        document.body.appendChild(toast);
        setTimeout(() => toast.remove(), 3000);

        setTimeout(() => {
          if (asciiPre) asciiPre.style.animation = '';
          asciiArt.style.filter = '';
        }, 2000);
        asciiClicks = 0;
      } else {
        // Show counter as a small tooltip
        let counter = document.getElementById('ascii-click-counter');
        if (!counter) {
          counter = document.createElement('div');
          counter.id = 'ascii-click-counter';
          counter.style.cssText = 'position:absolute;top:-8px;right:-8px;background:black;color:#fde047;border:2px solid black;border-radius:4px;padding:2px 8px;font-family:"Courier New",monospace;font-weight:700;font-size:12px;z-index:10;pointer-events:none;';
          asciiArt.style.position = 'relative';
          asciiArt.appendChild(counter);
        }
        counter.textContent = `${asciiClicks}/10 — ${messages[msgIdx]}`;
        setTimeout(() => { if (counter && counter.parentNode) counter.remove(); }, 1500);
      }

      asciiTimeout = setTimeout(() => { asciiClicks = 0; }, 2000);
    });
  }
</script>
