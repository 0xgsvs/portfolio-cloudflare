---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <title>404 — Page Not Found | Venkat Sundaraneedi</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <ClientRouter />
  </head>
  <body>
    <div class="container" style="min-height:100vh;display:flex;flex-direction:column;justify-content:center;align-items:center;padding:40px 16px;">

      <!-- HTTP Response header -->
      <div class="brutal-card card-red" style="max-width:520px;width:100%;font-family:monospace;font-size:13px;line-height:1.6;">
        <div style="font-weight:800;margin-bottom:4px;">$ curl -I https://0xgsvs.dev/this-page</div>
        <div style="opacity:0.75;">HTTP/1.1 404 Not Found</div>
        <div style="opacity:0.75;">Content-Type: text/html</div>
        <div style="opacity:0.75;">Server: nginx/1.27</div>
      </div>

      <!-- Glitch title -->
      <h1 style="font-size:clamp(24px,5vw,48px);margin:24px 0;text-align:center;">
        <span class="error-code">404: PAGE NOT FOUND</span>
      </h1>

      <!-- Terminal -->
      <div class="terminal-window" style="width:100%;">
        <div class="terminal-header">
          <span class="dot red"></span>
          <span class="dot yellow"></span>
          <span class="dot green"></span>
          <span style="margin-left:8px;">0xgsvs@terminal:~ (404)</span>
        </div>
        <div class="terminal-body" id="terminal-body">
          <div class="line prompt"><span class="dollar">$</span> # Welcome to the 404 Terminal</div>
          <div class="line prompt"><span class="dollar">$</span> # Type 'help' for available commands</div>
          <div class="line output">&nbsp;</div>
        </div>
        <form class="terminal-input-form" onsubmit="return handleSubmit(event)">
          <span class="dollar">$</span>
          <input type="text" id="terminal-input" placeholder="Type a command..." autofocus autocomplete="off" />
        </form>
      </div>

      <!-- Easter egg (hidden initially) -->
      <div id="easter-egg" class="easter-egg" style="display:none;max-width:520px;width:100%;">
        🍕 Fun fact: The developer thinks pineapple belongs on pizza. Controversial.
      </div>

      <!-- Home link -->
      <a href="/" style="margin-top:20px;padding:10px 20px;border:3px solid black;border-radius:6px;text-decoration:none;color:black;font-weight:700;font-family:Poppins,sans-serif;filter:drop-shadow(4px 4px 0 rgba(0,0,0,1));background:#fde047;transition:all 0.15s;">cd ~ (Go Home)</a>
    </div>
  </body>
</html>

<script>
  const COMMANDS: Record<string, string | string[]> = {
    help: [
      'Available commands:',
      '  help       - Show available commands',
      '  ls         - List pages',
      '  pwd        - Print working directory',
      '  whoami     - Display user info',
      '  clear      - Clear terminal',
      '  ls -la     - List all (including hidden)',
      '  cat .secret - Look inside .secret',
      '  cd ~       - Go home',
    ],
    ls: ['home/  projects/  .secret/'],
    pwd: ['/dev/null/404'],
    whoami: ['lost_soul@internet'],
    'ls -la': [
      'drwxr-xr-x .',
      'drwxr-xr-x ..',
      'drwxr-xr-x home/',
      'drwxr-xr-x projects/',
      'drwxr-xr-x .secret/',
    ],
    'ls -a': [
      'drwxr-xr-x .',
      'drwxr-xr-x ..',
      'drwxr-xr-x home/',
      'drwxr-xr-x projects/',
      'drwxr-xr-x .secret/',
    ],
    'cat .secret': '🎉 You found the easter egg!',
    'ls .secret': '🎉 You found the easter egg!',
    'cd .secret': '🎉 You found the easter egg!',
  };

  const NAV_COMMANDS: Record<string, string> = {
    'cd ~': '/',
    'cd /': '/',
    'cd home': '/',
    'cd projects': '/projects',
  };

  const body = document.getElementById('terminal-body')!;
  const input = document.getElementById('terminal-input') as HTMLInputElement;
  const easterEgg = document.getElementById('easter-egg')!;

  function addLine(text: string, type: string = 'output') {
    const div = document.createElement('div');
    div.className = `line ${type}`;
    div.textContent = text;
    body.appendChild(div);
    body.scrollTop = body.scrollHeight;
  }

  function addPrompt(text: string) {
    const div = document.createElement('div');
    div.className = 'line prompt';
    div.innerHTML = `<span class="dollar">$</span> ${escapeHtml(text)}`;
    body.appendChild(div);
    body.scrollTop = body.scrollHeight;
  }

  function escapeHtml(s: string): string {
    const d = document.createElement('div');
    d.textContent = s;
    return d.innerHTML;
  }

  function handleSubmit(e: Event): boolean {
    e.preventDefault();
    const cmd = input.value.trim().toLowerCase();
    if (!cmd) return false;

    addPrompt(cmd);
    input.value = '';

    // Check navigation first
    if (NAV_COMMANDS[cmd]) {
      window.location.href = NAV_COMMANDS[cmd];
      return false;
    }

    // Check for easter egg
    if (cmd === 'cat .secret' || cmd === 'ls .secret' || cmd === 'cd .secret') {
      addLine('Accessing secret directory...', 'yellow');
      addLine('🎉 You found the easter egg!', 'yellow');
      addLine("The developer likes pineapple on pizza. Controversial.", 'yellow');
      easterEgg.style.display = 'block';
      addLine('', 'output');
      return false;
    }

    // Check clear
    if (cmd === 'clear') {
      body.innerHTML = '';
      return false;
    }

    // Check commands
    const result = COMMANDS[cmd];
    if (result) {
      const lines = Array.isArray(result) ? result : [result];
      lines.forEach((line) => addLine(line, 'output'));
      addLine('', 'output');
    } else {
      addLine(`bash: ${cmd}: command not found`, 'error');
      addLine("Type 'help' for available commands", 'output');
      addLine('', 'output');
    }

    return false;
  }

  (window as any).handleSubmit = handleSubmit;
</script>
