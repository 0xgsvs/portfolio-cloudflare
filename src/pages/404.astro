---
import Manual from "../layouts/Manual.astro";
---

<Manual
  title="Page not found — Venkat Sundaraneedi"
  description="No manual entry for this page."
  manTitle="No Entry"
  manNumber="1"
  sectionLabel="System"
  tagline="No manual entry for the page you requested."
  noindex
>
  <Fragment slot="actions">
    <a class="action action--solid" href="/">cd ~ <span class="arrow" aria-hidden="true">↗</span></a>
    <a class="action" href="/writing">Writing</a>
    <a class="action" href="/contact">Contact</a>
  </Fragment>

  <section class="section" id="error">
    <div class="section-head">
      <span class="section-num">01</span>
      <h2>Error</h2>
    </div>
    <div class="prose">
      <p>
        The page does not exist, moved, or was never written. The rest of the manual is still
        indexed and searchable with <kbd>/</kbd>.
      </p>
      <p>
        Try <a href="/#work">work(1)</a>, <a href="/writing">writing(7)</a>, or{" "}
        <a href="/contact">contact(1)</a>.
      </p>
      <p class="synopsis">
        <code><span class="sig">man</span> — no entry for the requested path</code>
        <span class="muted">exit 1</span>
      </p>
    </div>
  </section>
</Manual>
