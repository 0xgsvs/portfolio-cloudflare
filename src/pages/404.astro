---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <style is:inline>
      :root { color-scheme: light; }
      html { background-color: #ffffff; }
    </style>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <meta name="description" content="Page not found." />
    <title>404 — Page Not Found | Venkat Sundaraneedi</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <ClientRouter />
  </head>
  <body>
    <main class="nf">
      <div class="brutal-card card-red nf-response">
        <div class="nf-cmd">$ curl -I https://0xgsvs.dev/this-page</div>
        <div class="nf-line">HTTP/1.1 404 Not Found</div>
        <div class="nf-line">Content-Type: text/html</div>
        <div class="nf-line">Server: nginx/1.27</div>
      </div>

      <h1 class="nf-title">404: page not found</h1>

      <div class="terminal-window">
        <div class="terminal-header">
          <span class="dots" aria-hidden="true">
            <span class="dot red"></span>
            <span class="dot yellow"></span>
            <span class="dot green"></span>
          </span>
          <span>0xgsvs@terminal:~ (404)</span>
        </div>
        <div class="terminal-body" id="term-body">
          <div class="line prompt"><span class="dollar">$</span> cd /this-page</div>
          <div class="line error">bash: cd: /this-page: No such file or directory</div>
          <div class="line output">Type 'help' for commands.</div>
          <div class="line output">&nbsp;</div>
        </div>
        <form class="terminal-input-form" id="term-form">
          <label class="visually-hidden" for="term-input">Terminal command</label>
          <span class="dollar" aria-hidden="true">$</span>
          <input
            type="text"
            id="term-input"
            name="command"
            placeholder="help"
            autocomplete="off"
            autocapitalize="off"
            spellcheck="false"
          />
        </form>
      </div>

      <a class="btn btn--accent nf-home" href="/">cd ~ (go home)</a>
    </main>
  </body>
</html>

<style>
  .nf {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    padding: var(--space-9) var(--space-4);
  }
  .nf-response {
    max-width: 520px;
    width: 100%;
    margin-bottom: 0;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: 1.6;
  }
  .nf-cmd {
    font-weight: 800;
    margin-bottom: var(--space-1);
  }
  .nf-line {
    color: var(--ink-2);
  }
  .nf-title {
    font-size: clamp(1.75rem, 5vw, var(--text-3xl));
    text-align: center;
  }
  .nf .terminal-window {
    width: 100%;
  }
  .nf-home {
    margin-top: var(--space-2);
  }
</style>

<script>
  const CMDS: Record<string, string[]> = {
    help: ['help / ls / whoami / pwd / clear / cd ~ / cat .secret'],
    ls: ['home/  work/  tools/  .secret/'],
    whoami: ['lost_soul@internet'],
    pwd: ['/dev/null/404'],
    'ls -la': ['drwxr-xr-x .', 'drwxr-xr-x ..', 'drwxr-xr-x home/', 'drwxr-xr-x work/', 'drwxr-xr-x .secret/'],
  };
  const NAV: Record<string, string> = { 'cd ~': '/', 'cd /': '/', 'cd home': '/', 'cd work': '/#work' };

  function init404() {
    const form = document.getElementById('term-form') as HTMLFormElement | null;
    const body = document.getElementById('term-body');
    const input = document.getElementById('term-input') as HTMLInputElement | null;
    if (!form || !body || !input || form.dataset.bound === 'true') return;
    form.dataset.bound = 'true';

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const cmd = input.value.trim().toLowerCase();
      if (!cmd) return;
      input.value = '';

      const prompt = document.createElement('div');
      prompt.className = 'line prompt';
      const dollar = document.createElement('span');
      dollar.className = 'dollar';
      dollar.textContent = '$';
      prompt.appendChild(dollar);
      prompt.appendChild(document.createTextNode(' ' + cmd));
      body.appendChild(prompt);

      const scroll = () => {
        body.scrollTop = body.scrollHeight;
      };

      if (NAV[cmd]) {
        window.location.href = NAV[cmd];
        return;
      }
      if (cmd === 'cat .secret' || cmd === 'ls .secret' || cmd === 'cd .secret') {
        window.location.href = '/secret';
        return;
      }
      if (cmd === 'clear') {
        body.innerHTML = '';
        return;
      }

      const lines = CMDS[cmd] ?? [`bash: ${cmd}: command not found`, "Type 'help' for commands"];
      lines.forEach((text) => {
        const line = document.createElement('div');
        line.className = 'line output';
        line.textContent = text;
        body.appendChild(line);
      });
      const spacer = document.createElement('div');
      spacer.className = 'line output';
      spacer.innerHTML = '&nbsp;';
      body.appendChild(spacer);
      scroll();
    });
  }

  init404();
  document.addEventListener('astro:page-load', init404);
</script>
