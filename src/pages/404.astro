---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <title>404 — Page Not Found | Venkat Sundaraneedi</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <ClientRouter />
  </head>
  <body>
    <div class="container" style="min-height:100vh;display:flex;flex-direction:column;justify-content:center;align-items:center;padding:40px 16px;">

      <!-- HTTP Response header -->
      <div class="brutal-card card-red" style="max-width:520px;width:100%;font-family:monospace;font-size:13px;line-height:1.6;">
        <div style="font-weight:800;margin-bottom:4px;">$ curl -I https://0xgsvs.dev/this-page</div>
        <div style="opacity:0.75;">HTTP/1.1 404 Not Found</div>
        <div style="opacity:0.75;">Content-Type: text/html</div>
        <div style="opacity:0.75;">Server: nginx/1.27</div>
      </div>

      <!-- Glitch title -->
      <h1 style="font-size:clamp(24px,5vw,48px);margin:24px 0;text-align:center;">
        <span class="error-code">404: PAGE NOT FOUND</span>
      </h1>

      <!-- Terminal -->
      <div class="terminal-window" style="width:100%;">
        <div class="terminal-header">
          <span class="dot red"></span>
          <span class="dot yellow"></span>
          <span class="dot green"></span>
          <span style="margin-left:8px;">0xgsvs@terminal:~ (404)</span>
        </div>
        <div class="terminal-body">
          <div class="line prompt"><span class="dollar">$</span> cd /this-page</div>
          <div class="line error">bash: cd: /this-page: No such file or directory</div>
          <div class="line prompt"><span class="dollar">$</span> _</div>
        </div>
      </div>

      <!-- Easter egg (hidden initially) -->
      <div id="easter-egg" class="easter-egg" style="display:none;max-width:520px;width:100%;">
        🍕 Fun fact: The developer thinks pineapple belongs on pizza. Controversial.
      </div>

      <!-- Home link -->
      <a href="/" style="margin-top:20px;padding:10px 20px;border:3px solid black;border-radius:6px;text-decoration:none;color:black;font-weight:700;font-family:Poppins,sans-serif;filter:drop-shadow(4px 4px 0 rgba(0,0,0,1));background:#fde047;transition:all 0.15s;">cd ~ (Go Home)</a>
    </div>
  </body>
</html>


