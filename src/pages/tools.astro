---
import Manual from "../layouts/Manual.astro";
import { tools } from "../data/site";
---

<Manual
  title="Tools — Venkat Sundaraneedi"
  description="The terminal tools Venkat Sundaraneedi uses day to day."
  manTitle="Tools"
  manNumber="1"
  sectionLabel="User Commands"
  tagline="The current terminal setup, grouped by what each one does."
  activeNav="tools"
  index={[{ id: "roles", label: "Roles", n: "01" }]}
>
  <Fragment slot="actions">
    <a class="action" href="/">Back to the manual</a>
    <a class="action" href="/contact">Contact</a>
  </Fragment>

  <section class="section" id="roles">
    <div class="section-head">
      <span class="section-num">01</span>
      <h2>Roles</h2>
      <p class="section-deck">Tools earn their place by shortening the loop. This list changes when they stop.</p>
    </div>
    <dl class="files">
      {tools.map((group) => (
        <div>
          <dt>{group.role}</dt>
          <dd>{group.items.join(" · ")}</dd>
          <span class="placeholder">{group.items.length} {group.items.length === 1 ? "tool" : "tools"}</span>
        </div>
      ))}
    </dl>
  </section>
</Manual>
