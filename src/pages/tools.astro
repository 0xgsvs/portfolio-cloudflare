---
import Manual from "../layouts/Manual.astro";
import { tools } from "../data/site";
---

<Manual
  title="Tools — Venkat Sundaraneedi"
  description="The terminal tools Venkat Sundaraneedi uses day to day."
  manTitle="Tools"
  manNumber="1"
  sectionLabel="User Commands"
  tagline="Personal terminal setup. The professional stack lives on the home page."
  activeNav="tools"
  index={[{ id: "roles", label: "Roles", n: "01" }]}
>
  <Fragment slot="actions">
    <a class="action" href="/">Back to the manual</a>
    <a class="action" href="/#description">Stack</a>
    <a class="action" href="/contact">Contact</a>
  </Fragment>

  <section class="section" id="roles">
    <div class="section-head">
      <span class="section-num">01</span>
      <h2>Roles</h2>
      <p class="section-deck">Arch, NixOS, and the terminal choices that keep the loop short. Personal, not the professional stack.</p>
    </div>
    <dl class="files">
      {tools.map((group) => (
        <div>
          <dt>{group.role}</dt>
          <dd>{group.items.join(" · ")}</dd>
          <span class="placeholder">{group.items.length} {group.items.length === 1 ? "tool" : "tools"}</span>
        </div>
      ))}
    </dl>
    <p class="tools-note muted small">Interested in TUI tools; the setup above is terminal-first.</p>
  </section>

  <style>
    .tools-note {
      margin-top: 1rem;
    }
  </style>
</Manual>
