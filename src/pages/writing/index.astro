---
import Manual from "../../layouts/Manual.astro";
import { posts } from "../../data/posts";
import { formatDate } from "../../utils/date";
---

<Manual
  title="Writing — Venkat Sundaraneedi"
  description="Notes on Rust, Solana, and Linux by Venkat Sundaraneedi."
  manTitle="Writing"
  manNumber="7"
  sectionLabel="Miscellaneous Information Manual"
  tagline="Notes on Rust, Solana, and Linux. Written when a problem deserves a record."
  activeNav="writing"
  index={[{ id: "inventory", label: "Inventory", n: "01" }]}
>
  <Fragment slot="actions">
    <a class="action" href="/">Back to the manual</a>
    <a class="action" href="/contact">Contact</a>
  </Fragment>

  <section class="section" id="inventory">
    <div class="section-head">
      <span class="section-num">01</span>
      <h2>Inventory</h2>
      <p class="section-deck">{posts.length} entries. No schedule, no feed, no newsletter.</p>
    </div>

    <ol class="entries">
      {posts.map((post) => (
        <li class="entry">
          <a href={`/writing/${post.slug}`}>
            <time datetime={post.date}>{formatDate(post.date)}</time>
            <span class="entry-title">{post.title}</span>
            <span class="entry-arrow" aria-hidden="true">↗</span>
            <span class="entry-excerpt">{post.excerpt}</span>
          </a>
        </li>
      ))}
    </ol>
  </section>
</Manual>
