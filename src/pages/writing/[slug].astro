---
import Manual from "../../layouts/Manual.astro";
import { posts } from "../../data/posts";
import { formatDate } from "../../utils/date";

export function getStaticPaths() {
  return posts.map((post) => ({ params: { slug: post.slug } }));
}

type Block =
  | { type: "h2"; text: string; id: string }
  | { type: "h3"; text: string }
  | { type: "p"; text: string }
  | { type: "ul"; items: { label?: string; text: string }[] }
  | { type: "code"; lang: string; code: string };

const escapeHtml = (text: string) =>
  text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");

const inline = (text: string) =>
  escapeHtml(text)
    .replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>")
    .replace(/`(.+?)`/g, "<code>$1</code>");

const slugify = (text: string) =>
  text
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-|-$/g, "");

function parseBlocks(source: string): { blocks: Block[]; headings: { id: string; label: string; n: string }[] } {
  const lines = source.split("\n");
  const blocks: Block[] = [];
  const headings: { id: string; label: string; n: string }[] = [];
  let index = 0;

  while (index < lines.length) {
    const line = lines[index];

    if (line.startsWith("```")) {
      const lang = line.slice(3).trim();
      const buffer: string[] = [];
      index++;
      while (index < lines.length && !lines[index].startsWith("```")) {
        buffer.push(lines[index]);
        index++;
      }
      index++;
      blocks.push({ type: "code", lang, code: buffer.join("\n") });
      continue;
    }

    if (line.startsWith("## ")) {
      const text = line.slice(3).trim();
      const id = slugify(text);
      blocks.push({ type: "h2", text, id });
      headings.push({ id, label: text, n: String(headings.length + 1).padStart(2, "0") });
      index++;
      continue;
    }

    if (line.startsWith("**") && line.endsWith("**") && line.length > 4) {
      blocks.push({ type: "h3", text: line.slice(2, -2).trim() });
      index++;
      continue;
    }

    if (line.startsWith("- ")) {
      const items: { label?: string; text: string }[] = [];
      while (index < lines.length && lines[index].startsWith("- ")) {
        const raw = lines[index].slice(2).trim();
        const match = raw.match(/^\*\*(.+?)\*\*:?\s*(.*)$/);
        if (match) items.push({ label: match[1].replace(/:\s*$/, ""), text: match[2] });
        else items.push({ text: raw });
        index++;
      }
      blocks.push({ type: "ul", items });
      continue;
    }

    if (line.trim() === "") {
      index++;
      continue;
    }

    const buffer: string[] = [];
    while (
      index < lines.length &&
      lines[index].trim() !== "" &&
      !lines[index].startsWith("#") &&
      !lines[index].startsWith("- ") &&
      !lines[index].startsWith("```")
    ) {
      buffer.push(lines[index].trim());
      index++;
    }
    if (buffer.length > 0) {
      blocks.push({ type: "p", text: buffer.join(" ") });
    } else {
      index++;
    }
  }

  return { blocks, headings };
}

const { slug } = Astro.params;
const post = posts.find((entry) => entry.slug === slug);
if (!post) throw new Error(`Unknown post: ${slug}`);
const { blocks, headings } = parseBlocks(post.content);
---

<Manual
  title={`${post.title} — Venkat Sundaraneedi`}
  description={post.excerpt}
  manTitle={post.title}
  runningTitle="Writing"
  manNumber="7"
  sectionLabel="Miscellaneous Information Manual"
  compact
  activeNav="writing"
  index={headings}
>
  <Fragment slot="actions">
    <a class="action" href="/writing">← All writing</a>
    <a class="action" href="/contact">Contact</a>
  </Fragment>

  <article>
    <header class="article-head">
      <div class="article-meta">
        <span>Written <time datetime={post.date}>{formatDate(post.date)}</time></span>
        {post.tags.map((tag) => <span class="tag">{tag}</span>)}
      </div>
    </header>

    <div class="prose">
      {
        blocks.map((block) => {
          if (block.type === "h2") return <h2 id={block.id} set:html={inline(block.text)} />;
          if (block.type === "h3") return <h3 set:html={inline(block.text)} />;
          if (block.type === "p") return <p set:html={inline(block.text)} />;
          if (block.type === "code")
            return (
              <figure class="prose-block">
                <figcaption class="prose-block-lang">{block.lang || "text"}</figcaption>
                <pre><code>{block.code}</code></pre>
              </figure>
            );
          return (
            <ul>
              {block.items.map((item) => (
                <li>
                  {item.label ? (
                    <>
                      <strong>{item.label}</strong>
                      {item.text ? ": " : ""}
                    </>
                  ) : null}
                  <span set:html={inline(item.text)} />
                </li>
              ))}
            </ul>
          );
        })
      }
    </div>
  </article>
</Manual>
