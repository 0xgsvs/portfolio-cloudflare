---
import Layout from '../layouts/Layout.astro';

const ua = (Astro.request.headers.get("user-agent") || "").toLowerCase();
const isCurl = ua.includes("curl") || ua.includes("wget") || ua.includes("httpie");

// Placeholder PGP key — replace with your real one!
const pgpKey = `-----BEGIN PGP PUBLIC KEY BLOCK-----

mQINBGabcdef1234567890ABCDEFGhijklmnopqrstuvwxyz
ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvw
xyz0123456789+/ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefg
hijklmnopqrstuvwxyz0123456789+/ABCDEFGHIJKLMNOPQ
RSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/AB
CDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxy
z0123456789+/ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghij
klmnopqrstuvwxyz0123456789+/ABCDEFGHIJKLMNOPQRSTU
=ABCD
-----END PGP PUBLIC KEY BLOCK-----

// ── REPLACE THIS WITH YOUR ACTUAL PGP PUBLIC KEY ──
// Generate one:  gpg --full-generate-key
// Export it:     gpg --armor --export your@email.com
// Then paste it above and delete this comment block.`;

const shortId = "ABCD 1234 EFGH 5678";
---

{ isCurl ? (
  <pre style="font-family:monospace;padding:20px;font-size:13px;">{pgpKey}</pre>
) : (
  <Layout title="PGP Key | Venkat Sundaraneedi" description="PGP public key for Venkat Sundaraneedi">
    <section class="section" style="padding-top:40px;">
      <h2 class="section-title">PGP PUBLIC KEY</h2>

      <div class="brutal-card card-yellow" style="max-width:700px;margin-bottom:24px;">
        <h3 style="margin-top:0;">🔑 Key Info</h3>
        <table style="font-size:14px;border-collapse:collapse;width:100%;">
          <tr><td style="padding:6px 12px 6px 0;font-weight:700;">Key ID:</td><td style="font-family:'Courier New',monospace;">{shortId}</td></tr>
          <tr><td style="padding:6px 12px 6px 0;font-weight:700;">Type:</td><td>RSA 4096 / Ed25519</td></tr>
          <tr><td style="padding:6px 12px 6px 0;font-weight:700;">Email:</td><td style="font-family:'Courier New',monospace;">venkat.subrahmanyam.34@gmail.com</td></tr>
          <tr><td style="padding:6px 12px 6px 0;font-weight:700;">Fingerprint:</td><td style="font-family:'Courier New',monospace;font-size:12px;">ABCD 1234 EFGH 5678 IJKL 9012 MNOP 3456 QRST 7890</td></tr>
        </table>
      </div>

      <div class="brutal-card card-purple" style="max-width:700px;margin-bottom:24px;">
        <h3 style="margin-top:0;">📥 Import my key</h3>
        <pre style="font-family:'Courier New',monospace;font-size:13px;line-height:1.6;overflow-x:auto;background:white;padding:12px;border:2px solid black;border-radius:4px;">
# From the web
curl -L https://0xgsvs.dev/pgp | gpg --import

# From keyserver
gpg --keyserver keys.openpgp.org --recv-keys ABCD1234EFGH5678</pre>
      </div>

      <div class="brutal-card" style="max-width:700px;">
        <h3 style="margin-top:0;">🔐 Public Key Block</h3>
        <pre style="font-family:'Courier New',monospace;font-size:11px;line-height:1.4;overflow-x:auto;white-space:pre-wrap;word-break:break-all;">{pgpKey}</pre>
        <p style="margin-top:12px;font-size:12px;opacity:0.6;">
          ⚠️ This is a placeholder key. Replace with your real PGP key.
          <a href="https://www.gnupg.org/gph/en/manual/c14.html" style="color:black;">Learn how to generate one →</a>
        </p>
      </div>
    </section>
  </Layout>
)}
