      </div>

      <div class="brutal-card card-blue" style="max-width:600px;">
        <h3 style="margin-top:0;">📬 Direct</h3>
        <p>Email: <strong>venkat.subrahmanyam.34@gmail.com</strong></p>
        <p>GitHub: <a href="https://github.com/0xgsvs" style="color:black;">github.com/0xgsvs</a></p>
      </div>
    </section>
  </Layout>
)}
