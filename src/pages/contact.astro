---
import Manual from "../layouts/Manual.astro";
import CommandLine from "../components/CommandLine.astro";
import { site } from "../data/site";
---

<Manual
  title="Contact — Venkat Sundaraneedi"
  description="Contact Venkat Sundaraneedi, Rust and Solana systems engineer."
  manTitle="Contact"
  manNumber="1"
  sectionLabel="User Commands"
  tagline="Email is the fastest route. Everything else is one link away."
  activeNav="contact"
  index={[
    { id: "contact", label: "Contact", n: "01" },
    { id: "examples", label: "Examples", n: "02" },
    { id: "files", label: "Files", n: "03" },
  ]}
>
  <Fragment slot="actions">
    <a class="action action--solid" href={`mailto:${site.email}`}>Email <span class="arrow" aria-hidden="true">↗</span></a>
    <a class="action" href={site.github} target="_blank" rel="noopener noreferrer">GitHub <span class="arrow" aria-hidden="true">↗</span></a>
    <a class="action" href="/cv-placeholder.pdf" download="venkat-cv.pdf">Download CV <span class="arrow" aria-hidden="true">↓</span></a>
  </Fragment>

  <section class="section" id="contact">
    <div class="section-head">
      <span class="section-num">01</span>
      <h2>Contact</h2>
    </div>
    <div class="prose">
      <p>
        For work, collaboration, or a question about something on this site, email is the fastest
        route. Include what you are building and what you need; a link helps.
      </p>
      <dl class="files">
        <div>
          <dt>Email</dt>
          <dd><a href={`mailto:${site.email}`} translate="no">{site.email}</a></dd>
          <span class="placeholder">Fastest</span>
        </div>
        <div>
          <dt>GitHub</dt>
          <dd><a href={site.github} target="_blank" rel="noopener noreferrer">github.com/0xgsvs</a></dd>
          <span class="placeholder">Source</span>
        </div>
        <div>
          <dt>CV</dt>
          <dd><a href="/cv-placeholder.pdf" download="venkat-cv.pdf">venkat-cv.pdf</a></dd>
          <span class="placeholder">Placeholder</span>
        </div>
      </dl>
    </div>
  </section>

  <section class="section" id="examples">
    <div class="section-head">
      <span class="section-num">02</span>
      <h2>Examples</h2>
      <p class="section-deck">No form, no database, no bot. Pull the vCard or copy the address.</p>
    </div>
    <CommandLine label="vCard" command="curl -L https://0xgsvs.dev/contact.txt" />
    <CommandLine label="Email" command={site.email} />
  </section>

  <section class="section" id="files">
    <div class="section-head">
      <span class="section-num">03</span>
      <h2>Files</h2>
    </div>
    <dl class="files">
      <div>
        <dt>Plain text</dt>
        <dd><a href="/contact.txt">contact.txt</a> — vCard, one request</dd>
        <span class="placeholder">Static</span>
      </div>
      <div>
        <dt>Guestbook</dt>
        <dd><a href="/guestbook">guestbook(8)</a> — leave a trace via GitHub</dd>
        <span class="placeholder">Public</span>
      </div>
    </dl>
  </section>

  <style>
    #examples .command + .command {
      margin-top: 1.25rem;
    }
  </style>
</Manual>
