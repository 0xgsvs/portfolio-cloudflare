---
import Manual from "../layouts/Manual.astro";
import CommandLine from "../components/CommandLine.astro";

const issueUrl =
  "https://github.com/0xgsvs/portfolio-cloudflare/issues/new?title=Guestbook%3A%20%5Byour%20name%5D&body=%23%23%20Guestbook%20Entry%0A%0A**Name%3A**%20%0A**From%3A**%20%0A**Message%3A**%20%0A%0A---%0A_Signed%20via%200xgsvs.dev%2Fguestbook_";
---

<Manual
  title="Guestbook — Venkat Sundaraneedi"
  description="Sign the guestbook with a GitHub issue."
  manTitle="Guestbook"
  manNumber="8"
  sectionLabel="Miscellaneous Information Manual"
  tagline="Leave a trace. It goes to GitHub, not a database."
  index={[
    { id: "sign", label: "Sign", n: "01" },
    { id: "method", label: "Method", n: "02" },
  ]}
>
  <Fragment slot="actions">
    <a class="action action--solid" href={issueUrl} target="_blank" rel="noopener noreferrer">
      Open GitHub issue <span class="arrow" aria-hidden="true">↗</span>
    </a>
  </Fragment>

  <section class="section" id="sign">
    <div class="section-head">
      <span class="section-num">01</span>
      <h2>Sign</h2>
    </div>
    <div class="prose">
      <p>
        The guestbook is a prefilled GitHub issue. Add your name and message, submit it, and it
        exists under your account. You need a GitHub account; this site has no accounts of its own.
      </p>
      <div class="actions">
        <a class="action action--solid" href={issueUrl} target="_blank" rel="noopener noreferrer">
          Sign the guestbook <span class="arrow" aria-hidden="true">↗</span>
        </a>
      </div>
      <p class="muted small">
        Nothing is stored here. I feature entries by editing this page, which means it moves at the
        speed of a human.
      </p>
    </div>
  </section>

  <section class="section" id="method">
    <div class="section-head">
      <span class="section-num">02</span>
      <h2>Method</h2>
      <p class="section-deck">For terminal users, the same action without the browser.</p>
    </div>
    <CommandLine
      label="GitHub CLI"
      command={`gh issue create --repo 0xgsvs/portfolio-cloudflare --title "Guestbook: [your name]" --body "Message here"`}
    />
  </section>
</Manual>
