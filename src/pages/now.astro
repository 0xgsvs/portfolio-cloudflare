---
import Layout from '../layouts/Layout.astro';

const nowItems = [
  { text: "Building a high-performance DEX aggregator on Solana with Rust and Anchor" },
  { text: "Writing a TUI file manager in Rust with ratatui — vim keybindings, preview panes" },
  { text: "Daily driving NixOS after 3 years on Arch. The declarative life chose me" },
  { text: "Learning Zig for systems programming. The comptime stuff is wild" },
  { text: "Running a Solana RPC node and indexer — on-chain data is addictive" },
  { text: "Reading: 'Crafting Interpreters' by Robert Nystrom. Finally understanding my tools" },
  { text: "Goal this month: ship the DEX aggregator MVP and write a deep-dive blog post" },
];

const lastUpdated = "2026-06-07";
---

<Layout title="Now | Venkat Sundaraneedi" description="What Venkat is working on right now">
  <section class="section">
    <div class="section-head">
      <span class="section-label">Now · updated {lastUpdated}</span>
      <h1 class="section-title">What I'm doing</h1>
      <p class="section-note">
        Inspired by <a href="https://nownownow.com/about">Derek Sivers' /now page movement</a>.
      </p>
    </div>

    <ul class="now-list">
      {
        nowItems.map((item) => (
          <li class="now-item">
            <span class="now-marker" aria-hidden="true">▸</span>
            <p>{item.text}</p>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>

<style>
  .now-list {
    list-style: none;
    border-top: 3px solid var(--line);
  }
  .now-item {
    display: grid;
    grid-template-columns: 24px minmax(0, 1fr);
    gap: var(--space-3);
    padding: var(--space-4) 0;
    border-bottom: 2px solid var(--line-soft);
  }
  .now-marker {
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--ink-3);
  }
  .now-item p {
    max-width: 68ch;
  }
  .section-note a {
    color: var(--ink);
  }
</style>
