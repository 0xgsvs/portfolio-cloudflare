---
import PixelGithub from '../generic/PixelGithub.astro';
import PixelEmail from '../generic/PixelEmail.astro';
---
<!-- Social links for mobile display -->
<div class="mobile-socials">
  <a href="https://github.com/0xgsvs" target="_blank" rel="noopener noreferrer" class="social-link card-purple" title="GitHub">
    <PixelGithub />
    <span>GitHub</span>
  </a>
  <a href="mailto:venkat.subrahmanyam.34@gmail.com" class="social-link card-blue" title="Email">
    <PixelEmail />
    <span>Email</span>
  </a>
</div>

<style>
  .mobile-socials {
    display: none;
    justify-content: center;
    gap: 12px;
    padding: 16px 0;
  }
  .social-link {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    border: 3px solid var(--black);
    border-radius: 8px;
    text-decoration: none;
    color: var(--black);
    font-weight: 700;
    font-size: 14px;
    filter: drop-shadow(3px 3px 0 rgba(0,0,0,1));
    transition: all 0.15s;
  }
  .social-link:hover {
    filter: drop-shadow(1px 1px 0 rgba(0,0,0,1));
    transform: translate(2px, 2px);
  }
  .social-link svg {
    width: 28px;
    height: auto;
  }
  @media (max-width: 768px) {
    .mobile-socials {
      display: flex;
    }
  }
</style>
