---

<!-- Fake Rust compiler loading screen — brutalist themed, auto-dismisses, skippable -->
<div id="compile-overlay" class="compile-overlay" hidden aria-label="Build output">
  <div class="compile-card">
    <p class="visually-hidden" id="compile-announce" role="status">Compiling.</p>
    <div class="compile-meta">
      <span>cargo build</span>
      <span class="compile-right">
        <span id="compile-timer" aria-hidden="true">0.0s</span>
        <button type="button" id="compile-skip" class="compile-skip">Skip</button>
      </span>
    </div>
    <pre id="compile-output" aria-hidden="true"></pre>
    <div class="compile-track" aria-hidden="true">
      <div id="compile-bar"></div>
    </div>
  </div>
</div>

<style>
  .compile-overlay {
    position: fixed;
    inset: 0;
    background: var(--white);
    z-index: 99999;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    padding: var(--space-4);
  }
  .compile-overlay[hidden] {
    display: none;
  }
  .compile-card {
    background: var(--white);
    border: 3px solid var(--line);
    padding: var(--space-6);
    max-width: 600px;
    width: 100%;
    filter: drop-shadow(7px 7px 0 rgba(0, 0, 0, 1));
  }
  .compile-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
    font-weight: 800;
    font-size: var(--text-xs);
    color: var(--ink-3);
    margin-bottom: var(--space-3);
  }
  .compile-right {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .compile-skip {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    border: 2px solid var(--line);
    background: var(--white);
    padding: 2px var(--space-2);
    min-height: 32px;
    cursor: pointer;
  }
  .compile-skip:hover {
    background: var(--ink);
    color: var(--white);
  }
  #compile-output {
    font-size: 12px;
    line-height: 1.6;
    white-space: pre-wrap;
    margin: 0;
    min-height: 60px;
  }
  .compile-track {
    margin-top: var(--space-3);
    height: 4px;
    background: var(--line-soft);
    overflow: hidden;
  }
  #compile-bar {
    height: 100%;
    width: 0%;
    background: var(--accent);
    transition: width 0.3s ease;
  }
</style>

<!-- Runs before paint: removes the overlay for reduced-motion users and repeat visits -->
<script is:inline data-astro-rerun>
  (function () {
    var overlay = document.getElementById('compile-overlay');
    if (!overlay) return;
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce || sessionStorage.getItem('compile-shown')) {
      overlay.remove();
      return;
    }
    overlay.hidden = false;
  })();
</script>

<script>
  // NOTE: this must stay a bundled module script. `data-astro-rerun` makes Astro
  // emit the source verbatim as a classic script, which cannot contain TypeScript.
  (function () {
    const overlay = document.getElementById('compile-overlay');
    if (!overlay || overlay.hidden) return;

    sessionStorage.setItem('compile-shown', '1');
    document.body.style.overflow = 'hidden';

    // The overlay covers the viewport, so the page behind it must leave the
    // tab order until it is gone.
    const page = document.getElementById('main');
    if (page) page.setAttribute('inert', '');

    const output = document.getElementById('compile-output')!;
    const bar = document.getElementById('compile-bar')!;
    const timer = document.getElementById('compile-timer')!;
    const skip = document.getElementById('compile-skip') as HTMLButtonElement;
    const announce = document.getElementById('compile-announce');

    const lines = [
      { html: '   Compiling 0xgsvs v0.1.0', pct: 15 },
      { html: '   Compiling personality v0.7.3', pct: 30 },
      { html: '   Compiling social_life v0.0.1', pct: 40 },
      { html: '', pct: 40 },
      { html: '<c:warn>warning</c>: unused variable: `weekend`', pct: 45 },
      { html: '   --> src/main.rs:42:9', pct: 45 },
      { html: ' 42 |     let weekend = plan_something();', pct: 45 },
      { html: '    |         ^^^^^^^ help: remove this, you know why', pct: 50 },
      { html: '', pct: 50 },
      { html: '<c:err>error[E0425]</c>: cannot find value `sleep` in this scope', pct: 55 },
      { html: '   --> src/main.rs:87:5', pct: 55 },
      { html: ' 87 |     sleep(8);', pct: 55 },
      { html: '    |     ^^^^^ not found in this scope', pct: 60 },
      { html: '    = note: try `cargo build --release` and go outside', pct: 65 },
      { html: '', pct: 65 },
      { html: '<c:err>error</c>: could not compile `0xgsvs` due to 1 previous error', pct: 70 },
      { html: '', pct: 70 },
      { html: '   Falling back to precompiled binary...', pct: 85 },
      { html: '<c:ok>   Finished</c> dev [unoptimized] in 1.8s', pct: 100 },
    ];

    function colorize(html: string) {
      return html
        .replace(/<c:warn>/g, '<span style="color:#854d0e;font-weight:700;">')
        .replace(/<c:err>/g, '<span style="color:#991b1b;font-weight:700;">')
        .replace(/<c:ok>/g, '<span style="color:#166534;font-weight:700;">')
        .replace(/<\/c>/g, '</span>');
    }

    let finished = false;
    let i = 0;
    let pending: ReturnType<typeof setTimeout> | undefined;

    function dismiss() {
      if (finished) return;
      finished = true;
      if (pending) clearTimeout(pending);
      document.body.style.overflow = '';
      if (page) page.removeAttribute('inert');
      // If focus was on the skip control, put it back on the page.
      if (overlay!.contains(document.activeElement) && page instanceof HTMLElement) {
        page.focus();
      }
      overlay!.style.opacity = '0';
      overlay!.style.transition = 'opacity 0.3s';
      setTimeout(() => overlay!.remove(), 320);
    }

    const startTime = performance.now();

    function typeNext() {
      if (finished) return;
      if (i < lines.length) {
        output.innerHTML += colorize(lines[i].html) + '\n';
        output.scrollTop = output.scrollHeight;
        bar.style.width = lines[i].pct + '%';
        timer.textContent = ((performance.now() - startTime) / 1000).toFixed(1) + 's';
        i++;
        pending = setTimeout(typeNext, 180 + Math.random() * 270);
      } else {
        bar.style.background = 'var(--green)';
        announce!.textContent = 'Build finished.';
        pending = setTimeout(dismiss, 500);
      }
    }

    skip.addEventListener('click', dismiss);
    pending = setTimeout(typeNext, 200);
  })();
</script>
