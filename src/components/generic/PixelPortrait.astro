<!-- Pixel-art self-portrait with hover tooltips -->
<div class="pixel-portrait" id="pixel-portrait">
  <svg viewBox="0 0 160 160" width="160" height="160" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Pixel-art self-portrait">
    <!-- Hair -->
    <rect x="35" y="10" width="90" height="25" rx="4" fill="#1a1a1a" data-zone="hair"/>
    <rect x="30" y="15" width="10" height="30" rx="2" fill="#1a1a1a" data-zone="hair"/>
    <rect x="120" y="15" width="10" height="30" rx="2" fill="#1a1a1a" data-zone="hair"/>
    <!-- Face -->
    <rect x="40" y="20" width="80" height="110" rx="8" fill="#fdba74" stroke="black" stroke-width="3"/>
    <!-- Eyes -->
    <rect x="55" y="50" width="20" height="16" rx="4" fill="white" stroke="black" stroke-width="2" data-zone="eyes"/>
    <rect x="85" y="50" width="20" height="16" rx="4" fill="white" stroke="black" stroke-width="2" data-zone="eyes"/>
    <circle cx="65" cy="58" r="5" fill="black" data-zone="eyes"/>
    <circle cx="95" cy="58" r="5" fill="black" data-zone="eyes"/>
    <circle cx="67" cy="56" r="2" fill="white"/>
    <circle cx="97" cy="56" r="2" fill="white"/>
    <!-- Eyebrows -->
    <rect x="53" y="44" width="24" height="5" rx="2" fill="black" data-zone="eyes"/>
    <rect x="83" y="44" width="24" height="5" rx="2" fill="black" data-zone="eyes"/>
    <!-- Nose -->
    <rect x="76" y="70" width="8" height="10" rx="3" fill="#e8a860" data-zone="nose"/>
    <!-- Mouth -->
    <path d="M 65 95 Q 80 108 100 95" fill="none" stroke="black" stroke-width="3" stroke-linecap="round" data-zone="mouth"/>
    <!-- Glasses -->
    <rect x="52" y="47" width="26" height="22" rx="5" fill="none" stroke="black" stroke-width="3" data-zone="glasses"/>
    <rect x="82" y="47" width="26" height="22" rx="5" fill="none" stroke="black" stroke-width="3" data-zone="glasses"/>
    <line x1="78" y1="58" x2="82" y2="58" stroke="black" stroke-width="3" data-zone="glasses"/>
    <!-- Ears -->
    <rect x="32" y="55" width="10" height="20" rx="4" fill="#fdba74" stroke="black" stroke-width="2" data-zone="ears"/>
    <rect x="118" y="55" width="10" height="20" rx="4" fill="#fdba74" stroke="black" stroke-width="2" data-zone="ears"/>
    <!-- Body -->
    <rect x="55" y="130" width="50" height="20" rx="3" fill="#93c5fd" stroke="black" stroke-width="2" data-zone="body"/>
    <!-- Brain overlay (invisible zone on forehead) -->
    <rect x="48" y="25" width="64" height="22" rx="4" fill="transparent" data-zone="brain"/>
  </svg>
  <div class="portrait-tooltip" id="portrait-tooltip" aria-hidden="true" style="display:none;"></div>
</div>

<style>
  .pixel-portrait {
    position: relative;
    display: inline-block;
    cursor: crosshair;
    filter: drop-shadow(4px 4px 0 rgba(0,0,0,1));
    transition: filter 0.15s;
  }
  .pixel-portrait:hover {
    filter: drop-shadow(2px 2px 0 rgba(0,0,0,1));
  }
  .portrait-tooltip {
    position: absolute;
    background: var(--black);
    color: var(--yellow);
    border: 2px solid var(--black);
    border-radius: 4px;
    padding: 4px 12px;
    font-family: "Courier New", monospace;
    font-size: 12px;
    font-weight: 700;
    white-space: nowrap;
    z-index: 10;
    pointer-events: none;
  }
</style>

<script>
  const tooltips: Record<string, string> = {
    hair: "Hair: 60% Nix flakes, 40% Arch AUR packages",
    brain: "Brain: 78% Rust compiler errors, 22% Solana RPC calls",
    eyes: "Eyes: currently staring at htop on tty2",
    glasses: "Glasses: prescription for reading compiler diagnostics at 2am",
    mouth: "Mouth: ':wq' muscle memory, also: 'btw I use NixOS'",
    ears: "Ears: tuned to lofi hip hop radio — beats to relax/study to",
    nose: "Nose: can smell Electron apps from 100 yards",
    body: "Hands: ~85 WPM, vim keybindings only, no arrow keys",
  };

  function initPortrait() {
    const portrait = document.getElementById('pixel-portrait');
    const tip = document.getElementById('portrait-tooltip');
    if (!portrait || !tip || portrait.dataset.bound === 'true') return;
    portrait.dataset.bound = 'true';

    function showAt(e: PointerEvent) {
      const zoneEl = (e.target as Element | null)?.closest('[data-zone]');
      const zone = zoneEl?.getAttribute('data-zone');
      if (zone && tooltips[zone]) {
        tip!.textContent = tooltips[zone];
        tip!.style.display = 'block';
        tip!.style.left = e.offsetX + 10 + 'px';
        tip!.style.top = Math.max(e.offsetY - 35, 0) + 'px';
      } else {
        tip!.style.display = 'none';
      }
    }

    function hide() {
      tip!.style.display = 'none';
    }

    portrait.addEventListener('pointermove', showAt);
    portrait.addEventListener('pointerdown', showAt);
    portrait.addEventListener('pointerleave', hide);
    portrait.addEventListener('pointercancel', hide);
  }

  initPortrait();
  document.addEventListener('astro:page-load', initPortrait);
</script>
