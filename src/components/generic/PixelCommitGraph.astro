<div class="commit-graph-wrapper" id="commit-graph-wrapper">
  <div class="brutal-card commit-graph-card" style="padding:20px 24px;">
    <h3 style="margin:0 0 4px;font-size:14px;font-weight:800;">RECENT ACTIVITY</h3>
    <p style="font-size:10px;opacity:0.4;margin:0 0 14px;font-family:'Courier New',monospace;">
      last 30 days · hover for details
    </p>

    <div class="commit-graph-container">
      <div class="commit-day-headers" id="commit-day-headers">
        <span>Sun</span><span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span>
      </div>
      <div class="commit-rows" id="commit-rows">
        <p style="font-size:11px;opacity:0.3;text-align:center;padding:20px 0;font-family:'Courier New',monospace;">loading...</p>
      </div>
    </div>

    <p id="commit-stats" class="commit-stats" style="display:none;"></p>

    <p id="commit-streak" class="commit-streak" style="display:none;"></p>

    <div class="commit-legend" id="commit-legend">
      <span><span class="commit-legend-dot c0"></span> <span class="legend-label">off</span></span>
      <span><span class="commit-legend-dot c1"></span> <span class="legend-label">light</span></span>
      <span><span class="commit-legend-dot c2"></span> <span class="legend-label">moderate</span></span>
      <span><span class="commit-legend-dot c3"></span> <span class="legend-label">busy</span></span>
      <span><span class="commit-legend-dot c4"></span> <span class="legend-label">intense</span></span>
    </div>

    <p style="font-size:10px;font-weight:700;font-family:'Courier New',monospace;opacity:0.3;margin:10px 0 0;">
      <a href="https://github.com/0xgsvs" target="_blank" rel="noopener noreferrer" style="color:inherit;text-decoration:none;">github.com/0xgsvs</a>
    </p>
  </div>
</div>

<style is:global>
  .commit-graph-wrapper { max-width: 640px; margin: 0 auto; padding: 12px 0; }
  .commit-graph-card { overflow: visible !important; }
  .commit-graph-container { display: flex; flex-direction: column; gap: 4px; align-items: center; }
  .commit-day-headers {
    display: grid;
    grid-template-columns: repeat(7, 18px);
    gap: 4px;
    margin-bottom: 2px;
    justify-content: center;
  }
  .commit-day-headers span {
    font-size: 8px;
    font-weight: 700;
    font-family: 'Courier New', monospace;
    opacity: 0.35;
    text-align: center;
    text-transform: uppercase;
  }
  .commit-rows {
    display: flex;
    flex-direction: column;
    gap: 4px;
    align-items: center;
  }
  .commit-week-row {
    display: grid;
    grid-template-columns: repeat(7, 18px);
    gap: 4px;
  }
  .commit-week-spacer {
    width: 18px; height: 18px;
    flex-shrink: 0;
  }
  .commit-block {
    width: 18px; height: 18px;
    border: 3px solid black;
    border-radius: 3px;
    flex-shrink: 0;
    box-sizing: border-box;
    transition: transform 0.1s;
    cursor: default;
  }
  .commit-block:hover { transform: scale(1.8); z-index: 2; }
  .commit-block.c0 { background: #ffffff; }
  .commit-block.c1 { background: #fde047; }
  .commit-block.c2 { background: #fdba74; }
  .commit-block.c3 { background: #fca5a5; }
  .commit-block.c4 { background: #d8b4fe; }
  @keyframes commitPopIn {
    0%   { transform: scale(0); opacity: 0; }
    60%  { transform: scale(1.3); }
    100% { transform: scale(1); opacity: 1; }
  }
  .commit-block.anim-in {
    animation: commitPopIn 0.25s ease-out both;
  }
  .commit-legend {
    display: flex; justify-content: center; gap: 14px;
    margin-top: 12px; font-size: 11px; font-weight: 600;
    opacity: 0.5; flex-wrap: wrap;
  }
  .commit-legend-dot {
    display: inline-block; width: 10px; height: 10px;
    border: 2px solid black; border-radius: 2px;
    margin-right: 3px; vertical-align: middle;
  }
  .commit-legend-dot.c0 { background: #ffffff; }
  .commit-legend-dot.c1 { background: #fde047; }
  .commit-legend-dot.c2 { background: #fdba74; }
  .commit-legend-dot.c3 { background: #fca5a5; }
  .commit-legend-dot.c4 { background: #d8b4fe; }
  .commit-stats {
    text-align: center; font-size: 11px; font-weight: 600;
    font-family: 'Courier New', monospace; opacity: 0.6;
    margin: 0 0 2px;
  }
  .commit-streak {
    text-align: center; font-size: 10px;
    font-family: 'Courier New', monospace; opacity: 0.45;
    margin: 0 0 4px;
  }
</style>

<script is:inline>
  (function() {
    var container = document.getElementById('commit-rows');
    if (!container) return;

    var months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
    var levels = ['off','light','moderate','busy','intense'];

    // Map GitHub contributionLevel → our 0-4 scale
    var levelMap = {
      NONE: 0,
      FIRST_QUARTILE: 1,
      SECOND_QUARTILE: 2,
      THIRD_QUARTILE: 3,
      FOURTH_QUARTILE: 4
    };

    function renderBlocks(days) {
      // days: array of 30 { date: "YYYY-MM-DD", count: number, level: 0-4 }
      // Layout: GitHub-style — Sun–Sat columns, one row per week
      container.innerHTML = '';

      // Determine day-of-week for the first day (0=Sun, 6=Sat)
      var firstDate = new Date(days[0].date + 'T00:00:00');
      var firstDow = firstDate.getDay(); // 0=Sun

      var rowDiv = null;
      var col = firstDow; // which column we're on
      var globalIdx = 0;

      function ensureRow() {
        if (!rowDiv) {
          rowDiv = document.createElement('div');
          rowDiv.className = 'commit-week-row';
          container.appendChild(rowDiv);
        }
      }

      // Pad with spacers before the first day
      ensureRow();
      for (var p = 0; p < firstDow; p++) {
        var spacer = document.createElement('div');
        spacer.className = 'commit-week-spacer';
        rowDiv.appendChild(spacer);
      }

      for (var i = 0; i < days.length; i++) {
        // Start new row when we wrap back to Sunday
        if (col === 0 && i > 0) {
          rowDiv = document.createElement('div');
          rowDiv.className = 'commit-week-row';
          container.appendChild(rowDiv);
        }

        var day = days[i];
        var cell = document.createElement('div');
        cell.className = 'commit-block anim-in c' + day.level;
        cell.style.animationDelay = (globalIdx * 0.03) + 's';
        globalIdx++;

        var d = new Date(day.date + 'T00:00:00');
        var label = levels[day.level];
        var countStr = day.count === 1 ? '1 contribution' : day.count + ' contributions';
        cell.title = months[d.getMonth()] + ' ' + d.getDate() + ' — ' + countStr + ' (' + label + ')';

        rowDiv.appendChild(cell);

        col++;
        if (col >= 7) col = 0; // wrap to next row
      }
    }

    // Fetch real data from public API
    fetch('https://github-contributions-api.deno.dev/0xgsvs.json')
      .then(function(res) {
        if (!res.ok) throw new Error('API returned ' + res.status);
        return res.json();
      })
      .then(function(data) {
        var allDays = [];
        var weeks = data.contributions;
        for (var w = 0; w < weeks.length; w++) {
          for (var d = 0; d < weeks[w].length; d++) {
            allDays.push(weeks[w][d]);
          }
        }

        // Take last 30 days
        var recent = allDays.slice(-30);

        var days = [];
        for (var i = 0; i < recent.length; i++) {
          days.push({
            date: recent[i].date,
            count: recent[i].contributionCount,
            level: levelMap[recent[i].contributionLevel] || 0
          });
        }

        renderBlocks(days);

        // Update stats summary
        var stats = document.getElementById('commit-stats');
        if (stats) {
          var total = 0;
          var active = 0;
          for (var i = 0; i < days.length; i++) {
            total += days[i].count;
            if (days[i].count > 0) active++;
          }
          var firstDate = days[0].date;
          var lastDate = days[days.length - 1].date;
          stats.textContent = total + ' contributions · ' + active + ' active days · ' + firstDate + ' – ' + lastDate;
          stats.style.display = 'block';
        }

        // Compute streaks
        var streak = document.getElementById('commit-streak');
        if (streak) {
          var currentStreak = 0;
          var longestStreak = 0;
          var running = 0;
          // Walk days newest→oldest for current streak
          for (var si = days.length - 1; si >= 0; si--) {
            if (days[si].count > 0) { currentStreak++; }
            else break;
          }
          // Walk all days old→new for longest streak
          for (var si = 0; si < days.length; si++) {
            if (days[si].count > 0) { running++; }
            else {
              if (running > longestStreak) longestStreak = running;
              running = 0;
            }
          }
          if (running > longestStreak) longestStreak = running;

          var streakText = 'current streak: ' + currentStreak + (currentStreak === 1 ? ' day' : ' days');
          streakText += ' · longest streak: ' + longestStreak + (longestStreak === 1 ? ' day' : ' days');
          streak.textContent = streakText;
          streak.style.display = 'block';
        }

        // Hardcoded legend labels
        var legendLabels = document.querySelectorAll('#commit-legend .legend-label');
        var labels = ['off', 'light (1–3)', 'moderate (4–8)', 'busy (9–15)', 'intense (16+)'];
        for (var li = 0; li < legendLabels.length; li++) {
          legendLabels[li].textContent = labels[li];
        }
      })
      .catch(function(err) {
        container.innerHTML = '<p style="font-size:11px;color:#fca5a5;text-align:center;padding:20px 0;font-family:\'Courier New\',monospace;">⚠ failed to load — ' + err.message + '</p>';
      });
  })();
</script>
