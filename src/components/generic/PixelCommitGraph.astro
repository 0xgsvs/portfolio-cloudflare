<!-- Pixel-art GitHub commit graph — static placeholder, can be wired to API -->
<div class="commit-graph">
  <h3 class="commit-graph-title">📊 CONTRIBUTION GRAPH</h3>
  <div class="commit-grid" id="commit-grid">
    <!-- Generated by JS below -->
  </div>
  <p class="commit-graph-note">
    github.com/0xgsvs — pixel-art commit graph
  </p>
</div>

<style>
  .commit-graph {
    text-align: center;
    padding: 20px 0;
    max-width: 700px;
    margin: 0 auto;
  }
  .commit-graph-title {
    font-size: 12px;
    font-weight: 700;
    font-family: "Courier New", monospace;
    margin-bottom: 12px;
    opacity: 0.6;
  }
  .commit-grid {
    display: flex;
    gap: 3px;
    justify-content: center;
    flex-wrap: wrap;
  }
  .commit-week {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .commit-cell {
    width: 12px;
    height: 12px;
    border: 1.5px solid rgba(0,0,0,0.3);
    border-radius: 2px;
    transition: transform 0.1s;
  }
  .commit-cell:hover {
    transform: scale(1.8);
    z-index: 2;
    border-color: black;
  }
  .commit-cell.c0 { background: #f0f0f0; }
  .commit-cell.c1 { background: #86efac; }
  .commit-cell.c2 { background: #4ade80; }
  .commit-cell.c3 { background: #22c55e; }
  .commit-cell.c4 { background: #166534; }
  .commit-graph-note {
    font-size: 10px;
    font-weight: 700;
    font-family: "Courier New", monospace;
    opacity: 0.3;
    margin-top: 8px;
  }
</style>

<script>
  // Generate a pixel-art style commit graph (52 weeks × 7 days)
  // This is seeded pseudo-random for visual consistency — swap with real API data later
  function seedRandom(seed: number) {
    return () => {
      seed = (seed * 16807) % 2147483647;
      return (seed - 1) / 2147483646;
    };
  }

  const grid = document.getElementById('commit-grid');
  if (grid) {
    const rand = seedRandom(42);
    const weeks = 52;
    const days = 7;

    // Create a realistic pattern: more activity on weekdays, bursts in recent weeks
    for (let w = 0; w < weeks; w++) {
      const week = document.createElement('div');
      week.className = 'commit-week';

      for (let d = 0; d < days; d++) {
        const cell = document.createElement('div');
        cell.className = 'commit-cell';

        // Biased toward recent weeks (more activity recently)
        const recency = (w / weeks); // 0 to 1
        const weekdayBias = (d >= 1 && d <= 4) ? 1.5 : 1.0; // Mon-Thu bias
        const raw = rand() * (1 + recency * 2) * weekdayBias;

        let level: number;
        if (raw < 0.4) level = 0;
        else if (raw < 0.7) level = 1;
        else if (raw < 1.0) level = 2;
        else if (raw < 1.5) level = 3;
        else level = 4;

        cell.className = `commit-cell c${level}`;
        cell.title = `${level} contributions`;

        // Click shows level
        cell.addEventListener('click', () => {
          const original = cell.textContent;
          cell.textContent = level > 0 ? '●' : '○';
          cell.style.fontSize = '8px';
          cell.style.textAlign = 'center';
          cell.style.lineHeight = '12px';
          cell.style.fontWeight = 'bold';
          setTimeout(() => {
            cell.textContent = '';
            cell.style.fontSize = '';
          }, 800);
        });

        week.appendChild(cell);
      }
      grid.appendChild(week);
    }
  }
</script>
