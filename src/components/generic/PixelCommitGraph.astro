<div class="commit-graph-wrapper" id="commit-graph-wrapper">
  <div class="brutal-card commit-graph-card" style="padding:20px 24px;">
    <h3 style="margin:0 0 4px;font-size:14px;font-weight:800;">RECENT ACTIVITY</h3>
    <p style="font-size:10px;opacity:0.4;margin:0 0 14px;font-family:'Courier New',monospace;">
      last 30 days · hover for date
    </p>

    <div class="commit-rows" id="commit-rows"></div>

    <div class="commit-legend">
      <span><span class="commit-legend-dot c0"></span> off</span>
      <span><span class="commit-legend-dot c1"></span> light</span>
      <span><span class="commit-legend-dot c2"></span> moderate</span>
      <span><span class="commit-legend-dot c3"></span> busy</span>
      <span><span class="commit-legend-dot c4"></span> intense</span>
    </div>

    <p style="font-size:10px;font-weight:700;font-family:'Courier New',monospace;opacity:0.3;margin:10px 0 0;">
      github.com/0xgsvs
    </p>
  </div>
</div>

<style is:global>
  .commit-graph-wrapper { max-width: 640px; margin: 0 auto; padding: 12px 0; }
  .commit-graph-card { overflow: visible !important; }
  .commit-rows { display: flex; flex-direction: column; gap: 4px; align-items: center; }
  .commit-row-line { display: flex; gap: 4px; }
  .commit-block {
    width: 18px; height: 18px;
    border: 3px solid black;
    border-radius: 3px;
    flex-shrink: 0;
    box-sizing: border-box;
    transition: transform 0.1s;
    cursor: default;
  }
  .commit-block:hover { transform: scale(1.8); z-index: 2; }
  .commit-block.c0 { background: #ffffff; }
  .commit-block.c1 { background: #fde047; }
  .commit-block.c2 { background: #fdba74; }
  .commit-block.c3 { background: #fca5a5; }
  .commit-block.c4 { background: #d8b4fe; }
  .commit-legend {
    display: flex; justify-content: center; gap: 14px;
    margin-top: 12px; font-size: 11px; font-weight: 600;
    opacity: 0.5; flex-wrap: wrap;
  }
  .commit-legend-dot {
    display: inline-block; width: 10px; height: 10px;
    border: 2px solid black; border-radius: 2px;
    margin-right: 3px; vertical-align: middle;
  }
  .commit-legend-dot.c0 { background: #ffffff; }
  .commit-legend-dot.c1 { background: #fde047; }
  .commit-legend-dot.c2 { background: #fdba74; }
  .commit-legend-dot.c3 { background: #fca5a5; }
  .commit-legend-dot.c4 { background: #d8b4fe; }
</style>

<script is:inline>
  (function() {
    var container = document.getElementById('commit-rows');
    if (!container || container.querySelector('.commit-block')) return;

    // Build date labels: today minus 0..30 days
    var today = new Date();
    var dates = [];
    for (var i = 0; i < 30; i++) {
      var d = new Date(today);
      d.setDate(d.getDate() - (29 - i));
      dates.push(d);
    }

    // Seeded PRNG
    var seed = 42;
    function rand() { seed = (seed * 16807) % 2147483647; return (seed - 1) / 2147483646; }

    // 2 rows of 15
    var rows = [[], []];
    for (var i = 0; i < 30; i++) {
      var rowIdx = i < 15 ? 0 : 1;
      rows[rowIdx].push(i);
    }

    for (var r = 0; r < rows.length; r++) {
      if (rows[r].length === 0) continue;
      var rowDiv = document.createElement('div');
      rowDiv.className = 'commit-row-line';

      for (var j = 0; j < rows[r].length; j++) {
        var idx = rows[r][j];
        var cell = document.createElement('div');

        // More activity on recent days + weekdays
        var recency = (idx + 1) / 30;
        var dayOfWeek = dates[idx].getDay(); // 0=Sun, 6=Sat
        var weekend = (dayOfWeek === 0 || dayOfWeek === 6) ? 0.4 : 1.0;
        var raw = rand() * (0.5 + recency * 2.5) * weekend;

        var lvl;
        if (raw < 0.4) lvl = 0;
        else if (raw < 0.8) lvl = 1;
        else if (raw < 1.2) lvl = 2;
        else if (raw < 1.8) lvl = 3;
        else lvl = 4;

        cell.className = 'commit-block c' + lvl;

        var months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
        var d = dates[idx];
        var label = ['off','light','moderate','busy','intense'][lvl];
        cell.title = months[d.getMonth()] + ' ' + d.getDate() + ' — ' + label;

        rowDiv.appendChild(cell);
      }
      container.appendChild(rowDiv);
    }
  })();
</script>
