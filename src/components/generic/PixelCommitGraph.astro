---
---

<div class="commit-graph" id="commit-graph-wrapper">
  <h2 class="commit-title">Recent activity</h2>
  <p class="commit-note">Last 30 days. Hover a block for the day's count.</p>

  <div class="commit-graph-container">
    <div class="commit-day-headers" id="commit-day-headers">
      <span>Sun</span><span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span>
    </div>
    <div class="commit-rows" id="commit-rows">
      <p class="commit-loading">Loading contributions…</p>
    </div>
  </div>

  <p id="commit-stats" class="commit-stats" hidden></p>
  <p id="commit-streak" class="commit-streak" hidden></p>

  <div class="commit-legend" id="commit-legend">
    <span><span class="commit-legend-dot c0"></span> <span class="legend-label">off</span></span>
    <span><span class="commit-legend-dot c1"></span> <span class="legend-label">light</span></span>
    <span><span class="commit-legend-dot c2"></span> <span class="legend-label">moderate</span></span>
    <span><span class="commit-legend-dot c3"></span> <span class="legend-label">busy</span></span>
    <span><span class="commit-legend-dot c4"></span> <span class="legend-label">intense</span></span>
  </div>

  <p class="commit-source">
    <a href="https://github.com/0xgsvs" target="_blank" rel="noopener noreferrer">github.com/0xgsvs</a>
  </p>
</div>

<style is:global>
  .commit-graph {
    border-top: 2px solid var(--line-soft);
    padding-top: var(--space-4);
  }
  .commit-title {
    font-size: var(--text-sm);
    font-weight: 800;
    letter-spacing: 0.02em;
    margin-bottom: var(--space-1);
  }
  .commit-note {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-3);
    margin-bottom: var(--space-4);
  }
  .commit-graph-container {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .commit-day-headers {
    display: grid;
    grid-template-columns: repeat(7, 18px);
    gap: 4px;
    margin-bottom: 2px;
  }
  .commit-day-headers span {
    font-size: 9px;
    font-weight: 700;
    font-family: var(--font-mono);
    color: var(--ink-3);
    text-align: center;
    text-transform: uppercase;
  }
  .commit-rows {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .commit-loading {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-3);
    padding: var(--space-3) 0;
  }
  .commit-week-row {
    display: grid;
    grid-template-columns: repeat(7, 18px);
    gap: 4px;
  }
  .commit-week-spacer {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }
  .commit-block {
    width: 18px;
    height: 18px;
    border: 2px solid var(--line);
    flex-shrink: 0;
    transition: transform 0.1s ease;
  }
  .commit-block:hover {
    transform: scale(1.6);
    position: relative;
    z-index: 2;
  }
  .commit-block.c0 { background: #ffffff; }
  .commit-block.c1 { background: #fde047; }
  .commit-block.c2 { background: #fdba74; }
  .commit-block.c3 { background: #fca5a5; }
  .commit-block.c4 { background: #d8b4fe; }

  @keyframes commitPopIn {
    0% { transform: scale(0); opacity: 0; }
    60% { transform: scale(1.3); }
    100% { transform: scale(1); opacity: 1; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .commit-block.anim-in {
      animation: commitPopIn 0.25s ease-out both;
    }
  }

  .commit-legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-2);
  }
  .commit-legend-dot {
    display: inline-block;
    width: 10px;
    height: 10px;
    border: 2px solid var(--line);
    margin-inline-end: 3px;
    vertical-align: middle;
  }
  .commit-legend-dot.c0 { background: #ffffff; }
  .commit-legend-dot.c1 { background: #fde047; }
  .commit-legend-dot.c2 { background: #fdba74; }
  .commit-legend-dot.c3 { background: #fca5a5; }
  .commit-legend-dot.c4 { background: #d8b4fe; }

  .commit-stats {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--ink-2);
    margin-top: var(--space-4);
  }
  .commit-streak {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-3);
    margin-top: var(--space-1);
  }
  .commit-source {
    margin-top: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
  }
  .commit-source a {
    color: var(--ink-2);
  }
</style>

<script is:inline>
  (function () {
    var container = document.getElementById('commit-rows');
    if (!container) return;

    var months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
    var levels = ['off','light','moderate','busy','intense'];
    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    var levelMap = {
      NONE: 0,
      FIRST_QUARTILE: 1,
      SECOND_QUARTILE: 2,
      THIRD_QUARTILE: 3,
      FOURTH_QUARTILE: 4
    };

    function renderBlocks(days) {
      container.innerHTML = '';

      var firstDate = new Date(days[0].date + 'T00:00:00');
      var firstDow = firstDate.getDay();

      var rowDiv = null;
      var col = firstDow;
      var globalIdx = 0;

      function ensureRow() {
        if (!rowDiv) {
          rowDiv = document.createElement('div');
          rowDiv.className = 'commit-week-row';
          container.appendChild(rowDiv);
        }
      }

      ensureRow();
      for (var p = 0; p < firstDow; p++) {
        var spacer = document.createElement('div');
        spacer.className = 'commit-week-spacer';
        rowDiv.appendChild(spacer);
      }

      for (var i = 0; i < days.length; i++) {
        if (col === 0 && i > 0) {
          rowDiv = document.createElement('div');
          rowDiv.className = 'commit-week-row';
          container.appendChild(rowDiv);
        }

        var day = days[i];
        var cell = document.createElement('div');
        cell.className = 'commit-block c' + day.level;
        if (!reduceMotion) {
          cell.className += ' anim-in';
          cell.style.animationDelay = globalIdx * 0.03 + 's';
        }
        globalIdx++;

        var d = new Date(day.date + 'T00:00:00');
        var label = levels[day.level];
        var countStr = day.count === 1 ? '1 contribution' : day.count + ' contributions';
        cell.title = months[d.getMonth()] + ' ' + d.getDate() + ' — ' + countStr + ' (' + label + ')';

        rowDiv.appendChild(cell);

        col++;
        if (col >= 7) col = 0;
      }
    }

    fetch('https://github-contributions-api.deno.dev/0xgsvs.json')
      .then(function (res) {
        if (!res.ok) throw new Error('API returned ' + res.status);
        return res.json();
      })
      .then(function (data) {
        var allDays = [];
        var weeks = data.contributions;
        for (var w = 0; w < weeks.length; w++) {
          for (var d = 0; d < weeks[w].length; d++) {
            allDays.push(weeks[w][d]);
          }
        }

        var recent = allDays.slice(-30);
        var days = [];
        for (var i = 0; i < recent.length; i++) {
          days.push({
            date: recent[i].date,
            count: recent[i].contributionCount,
            level: levelMap[recent[i].contributionLevel] || 0
          });
        }

        renderBlocks(days);

        var stats = document.getElementById('commit-stats');
        if (stats) {
          var total = 0;
          var active = 0;
          for (var s = 0; s < days.length; s++) {
            total += days[s].count;
            if (days[s].count > 0) active++;
          }
          stats.textContent =
            total + ' contributions · ' + active + ' active days · ' +
            days[0].date + ' to ' + days[days.length - 1].date;
          stats.hidden = false;
        }

        var streak = document.getElementById('commit-streak');
        if (streak) {
          var currentStreak = 0;
          var longestStreak = 0;
          var running = 0;

          for (var ci = days.length - 1; ci >= 0; ci--) {
            if (days[ci].count > 0) currentStreak++;
            else break;
          }
          for (var li = 0; li < days.length; li++) {
            if (days[li].count > 0) {
              running++;
            } else {
              if (running > longestStreak) longestStreak = running;
              running = 0;
            }
          }
          if (running > longestStreak) longestStreak = running;

          streak.textContent =
            'current streak: ' + currentStreak + (currentStreak === 1 ? ' day' : ' days') +
            ' · longest streak: ' + longestStreak + (longestStreak === 1 ? ' day' : ' days');
          streak.hidden = false;
        }

        var legendLabels = document.querySelectorAll('#commit-legend .legend-label');
        var labels = ['off', 'light (1–3)', 'moderate (4–8)', 'busy (9–15)', 'intense (16+)'];
        for (var ll = 0; ll < legendLabels.length; ll++) {
          legendLabels[ll].textContent = labels[ll];
        }
      })
      .catch(function (err) {
        container.innerHTML = '';
        var p = document.createElement('p');
        p.className = 'commit-loading';
        p.textContent = 'Contributions unavailable — ' + err.message;
        container.appendChild(p);
      });
  })();
</script>
