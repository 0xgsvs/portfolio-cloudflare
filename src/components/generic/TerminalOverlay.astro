<!-- Floating terminal overlay — open with the header button or the ` key -->
<div
  id="term-overlay"
  class="term-overlay"
  role="dialog"
  aria-modal="true"
  aria-labelledby="term-overlay-title"
  hidden
>
  <div class="term-overlay-backdrop" id="term-backdrop"></div>
  <div class="terminal-window term-floating" id="term-window">
    <div class="terminal-header">
      <span class="dots" aria-hidden="true">
        <span class="dot red"></span>
        <span class="dot yellow"></span>
        <span class="dot green"></span>
      </span>
      <span id="term-overlay-title">0xgsvs@portfolio:~</span>
      <button type="button" class="term-close" id="term-close-btn">
        Close <span aria-hidden="true">`</span>
      </button>
    </div>
    <div class="terminal-body" id="term-overlay-body">
      <div class="line output">Type 'help' for available commands. Press ` or Esc to close.</div>
      <div class="line output">&nbsp;</div>
    </div>
    <form class="terminal-input-form" id="term-overlay-form">
      <label class="visually-hidden" for="term-overlay-input">Terminal command</label>
      <span class="dollar" aria-hidden="true">$</span>
      <input
        type="text"
        id="term-overlay-input"
        name="command"
        placeholder="help"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
      />
    </form>
  </div>
</div>

<style>
  .term-overlay {
    position: fixed;
    inset: 0;
    z-index: 10000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }
  .term-overlay[hidden] {
    display: none;
  }
  .term-overlay-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
  }
  .term-floating {
    position: relative;
    z-index: 10001;
    width: 100%;
    max-width: 650px;
    max-height: 80vh;
    display: flex;
    flex-direction: column;
  }
  .term-floating .terminal-body {
    flex: 1;
    min-height: 200px;
  }
  .term-close {
    margin-inline-start: auto;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--white);
    background: transparent;
    border: 2px solid var(--white);
    padding: 4px 10px;
    min-height: 32px;
    cursor: pointer;
  }
  .term-close:hover {
    background: var(--white);
    color: var(--ink);
  }
</style>

<script>
  const COMMANDS: Record<string, string | string[]> = {
    help: [
      'Available commands:',
      '  help        - Show this',
      '  whoami      - Who I am',
      '  ls          - List pages',
      '  work        - Selected projects',
      '  contact     - Get in touch',
      '  clear       - Clear the scrollback',
      '  exit        - Close the terminal',
      '  cat .secret - Look inside .secret',
      '  neofetch    - System info',
      '  cowsay      - The cow speaks',
    ],
    whoami: ['venkat@0xgsvs.dev — Rust & Blockchain Developer'],
    ls: ['home/  work/  contact/  .secret/  gpg/  now/  writing/'],
    work: [
      'Selected projects:',
      '  01. Solana DEX Aggregator — Rust, Anchor, Web3',
      '  02. Rust TUI File Manager — ratatui, vim bindings',
      '  03. Solana Indexer — PostgreSQL, Redis, real-time',
      '',
      'Source: github.com/0xgsvs',
    ],
    projects: [
      'Selected projects:',
      '  01. Solana DEX Aggregator — Rust, Anchor, Web3',
      '  02. Rust TUI File Manager — ratatui, vim bindings',
      '  03. Solana Indexer — PostgreSQL, Redis, real-time',
      '',
      'Source: github.com/0xgsvs',
    ],
    contact: [
      'Email:  venkat.subrahmanyam.34@gmail.com',
      'GitHub: github.com/0xgsvs',
      'GPG:    https://0xgsvs.dev/gpg.txt',
      '',
      'curl -L https://0xgsvs.dev/contact.txt',
    ],
    neofetch: [
      '        ......            venkat@0xgsvs.dev',
      '      .:--------:.        -----------------',
      '    .:------------:.      OS: Arch Linux / NixOS dual boot',
      '   .:---:------:---:.     Shell: zsh + tmux',
      '  .:----:--------:--:.    Editor: neovim (btw)',
      '  .:----------------:.    Lang: Rust, Zig, TypeScript',
      '  .:----------------:.    Theme: pastel brutalist',
      '   .:--------------:.     Uptime: since last kernel panic',
    ],
    cowsay: [
      '  ------------------------------------',
      ' < Rust is the only language where   >',
      ' < the compiler is also your therapist >',
      '  ------------------------------------',
      '         \\   ^__^',
      '          \\  (oo)\\_______',
      '             (__)\\       )\\/\\',
      '                 ||----w |',
      '                 ||     ||',
    ],
  };

  const NAV: Record<string, string> = {
    'cd /': '/',
    'cd ~': '/',
    'cd home': '/',
    'cd work': '/#work',
    'cd projects': '/#work',
    'cd contact': '/#contact',
  };

  function initTerminalOverlay() {
    const overlay = document.getElementById('term-overlay');
    const backdrop = document.getElementById('term-backdrop');
    const body = document.getElementById('term-overlay-body');
    const form = document.getElementById('term-overlay-form') as HTMLFormElement | null;
    const input = document.getElementById('term-overlay-input') as HTMLInputElement | null;
    const closeBtn = document.getElementById('term-close-btn');
    const trigger = document.getElementById('term-open');
    const page = document.getElementById('main');

    if (!overlay || overlay.dataset.bound === 'true') return;
    overlay.dataset.bound = 'true';
    if (!backdrop || !body || !form || !input || !closeBtn || !page) return;

    let restoreFocusTo: HTMLElement | null = null;

    function addLine(text: string, cls = 'output') {
      const div = document.createElement('div');
      div.className = `line ${cls}`;
      div.textContent = text;
      body!.appendChild(div);
      body!.scrollTop = body!.scrollHeight;
    }

    function addPrompt(text: string) {
      const div = document.createElement('div');
      div.className = 'line prompt';
      const dollar = document.createElement('span');
      dollar.className = 'dollar';
      dollar.textContent = '$';
      div.appendChild(dollar);
      div.appendChild(document.createTextNode(' ' + text));
      body!.appendChild(div);
      body!.scrollTop = body!.scrollHeight;
    }

    function open(origin?: HTMLElement | null) {
      restoreFocusTo = origin ?? (document.activeElement as HTMLElement | null);
      page!.setAttribute('inert', '');
      overlay!.hidden = false;
      input!.focus();
    }

    function close() {
      overlay!.hidden = true;
      page!.removeAttribute('inert');
      if (restoreFocusTo && document.contains(restoreFocusTo)) {
        restoreFocusTo.focus();
      } else if (trigger instanceof HTMLElement) {
        trigger.focus();
      }
      restoreFocusTo = null;
    }

    function focusable() {
      return Array.from(
        overlay!.querySelectorAll<HTMLElement>('button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])')
      ).filter((el) => !el.hasAttribute('disabled'));
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const cmd = input.value.trim().toLowerCase();
      if (!cmd) return;
      addPrompt(cmd);
      input.value = '';

      if (NAV[cmd]) {
        window.location.href = NAV[cmd];
        return;
      }
      if (cmd === 'cat .secret' || cmd === 'ls .secret' || cmd === 'cd .secret') {
        addLine('Accessing .secret ...', 'yellow');
        window.location.href = '/secret';
        return;
      }
      if (cmd === 'clear') {
        body.innerHTML = '';
        return;
      }
      if (cmd === 'exit' || cmd === 'quit' || cmd === ':q' || cmd === ':wq') {
        close();
        return;
      }
      if (cmd === 'sudo rm -rf /') {
        addLine('Nice try. This is a static site.', 'error');
        addLine('', 'output');
        return;
      }

      const result = COMMANDS[cmd];
      if (result) {
        const lines = Array.isArray(result) ? result : [result];
        lines.forEach((l) => addLine(l, 'output'));
        addLine('', 'output');
      } else {
        addLine(`bash: ${cmd}: command not found`, 'error');
        addLine("Type 'help' for available commands", 'output');
        addLine('', 'output');
      }
    });

    document.addEventListener('keydown', (e) => {
      const isOpen = overlay.hidden === false;

      if (e.key === 'Escape' && isOpen) {
        close();
        return;
      }

      if (e.key === '`' || e.key === '~') {
        const target = e.target as HTMLElement | null;
        const typing = target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement;
        if (typing && !isOpen) return;
        e.preventDefault();
        if (isOpen) {
          close();
        } else {
          open(target);
        }
        return;
      }

      if (e.key === 'Tab' && isOpen) {
        const items = focusable();
        if (items.length === 0) return;
        const first = items[0];
        const last = items[items.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    });

    backdrop.addEventListener('click', close);
    closeBtn.addEventListener('click', close);
    if (trigger) {
      trigger.addEventListener('click', () => open(trigger));
    }
  }

  initTerminalOverlay();
  document.addEventListener('astro:page-load', initTerminalOverlay);
</script>
