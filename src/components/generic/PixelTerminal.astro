<!-- Terminal icon - Pastel Brutalist style -->
<svg width="48" height="36" viewBox="0 0 48 36" fill="none" xmlns="http://www.w3.org/2000/svg">
  <!-- Monitor frame -->
  <rect x="2" y="2" width="44" height="28" rx="3" fill="white" stroke="black" stroke-width="3"/>
  <!-- Screen -->
  <rect x="6" y="6" width="36" height="20" fill="white" stroke="black" stroke-width="2"/>
  <!-- Prompt -->
  <text x="12" y="20" font-family="monospace" font-size="14" font-weight="bold" fill="black">$ _</text>
  <!-- Stand -->
  <rect x="18" y="30" width="12" height="4" fill="black"/>
  <rect x="14" y="32" width="20" height="4" rx="1" fill="black"/>
</svg>
