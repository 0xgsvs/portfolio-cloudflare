<header class="header">
  <div class="logo">
    <span class="diamond" id="header-diamond">◆</span> PORTFOLIO
  </div>
  <nav class="nav-links">
    <a href="/">Home</a>
    <a href="/#projects">Projects</a>
    <a href="/#tech">Tech Stack</a>
    <a href="/contact">Contact</a>
  </nav>
</header>

<style>
  .diamond {
    cursor: default;
    display: inline-block;
    transition: transform 0.2s;
    user-select: none;
  }
  .diamond.shaking {
    animation: diamondShake 0.15s ease-in-out;
  }
  .diamond.destroyed {
    animation: diamondShatter 0.6s ease-in forwards;
  }
  @keyframes diamondShake {
    0%, 100% { transform: translate(0, 0); }
    25% { transform: translate(-3px, -2px); }
    50% { transform: translate(3px, 1px); }
    75% { transform: translate(-2px, 2px); }
  }
  @keyframes diamondShatter {
    0% { opacity: 1; transform: scale(1) rotate(0deg); }
    20% { opacity: 1; transform: scale(1.3) rotate(10deg); }
    100% { opacity: 0; transform: scale(0) rotate(180deg) translateY(-40px); }
  }
</style>

<script>
  const diamond = document.getElementById('header-diamond');
  if (diamond) {
    let clicks = 0;
    let timeout: ReturnType<typeof setTimeout>;

    diamond.addEventListener('click', () => {
      clicks++;
      clearTimeout(timeout);

      // Shake on every click
      diamond.classList.remove('shaking');
      void (diamond as HTMLElement).offsetWidth; // force reflow
      diamond.classList.add('shaking');

      if (clicks >= 5) {
        diamond.classList.remove('shaking');
        diamond.classList.add('destroyed');

        // Show toast
        const toast = document.createElement('div');
        toast.style.cssText = 'position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:black;color:#fde047;border:3px solid #fde047;border-radius:8px;padding:12px 24px;font-family:"Courier New",monospace;font-weight:700;font-size:14px;z-index:9999;animation:toastIn 0.3s ease-out,toastOut 0.3s ease-in 2.7s forwards;';
        toast.textContent = '💎 You broke it. Happy now? It\'ll be back...';
        document.body.appendChild(toast);
        setTimeout(() => toast.remove(), 3000);

        // Respawn after delay
        setTimeout(() => {
          diamond.classList.remove('destroyed');
          diamond.style.opacity = '1';
        }, 2000);

        clicks = 0;
      } else {
        timeout = setTimeout(() => { clicks = 0; }, 1000);
      }
    });
  }
</script>
