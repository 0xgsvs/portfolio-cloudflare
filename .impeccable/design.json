  "narrative": {
    "northStar": "The Field Manual",
    "overview": "The site is one printed manual for a working system. Manila stock, dense mono text, numbered sections, ruled margins, and a single vermilion signal carry the whole surface. Every section is an addressable entry; every claim about work carries a real repository, a program ID, or a test count. The world is flat, legible, and deliberate. It refuses the hero-plus-cards scaffold, the dark editor cliché, and decorative terminal chrome.",
    "keyCharacteristics": [
      "Warm manila paper ground with near-black ink and one signal red.",
      "A 6rem display masthead against a 16px mono body.",
      "Hairline rules, zero radius, and no shadows; depth is only paper tone and ink weight.",
      "A persistent right margin index with a red numeral and an ink active state.",
      "A keyboard-first command palette that behaves like the manual's index."
    ],
    "rules": [
      {
        "name": "The Rule Weight Rule",
        "body": "Section boundaries are 1px Press Ink. Internal rows are 1px Hairline. No border is thicker than 1px, and no border is rounded.",
        "section": "colors"
      },
      {
        "name": "The 6rem Ceiling",
        "body": "Display type never exceeds 6rem, however wide the viewport.",
        "section": "typography"
      },
      {
        "name": "The Margin Numeral Rule",
        "body": "Section numbers live in the left gutter as vermilion labels, never inside the heading text and never as an indented kicker above it.",
        "section": "typography"
      },
      {
        "name": "The Readable Mono Rule",
        "body": "Mono is the body because this is a manual, not because mono looks technical. It never drops below 13px for content, and every long hash wraps rather than forcing a horizontal scroll.",
        "section": "typography"
      },
      {
        "name": "The One Signal Rule",
        "body": "Vermilion is a mark, never a surface. It may color a numeral, a status, an underline, a focus ring, or a live bar. It never fills a region larger than a line of type.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do keep the paper ground, the ink ramp, and the one vermilion signal as the entire palette.",
      "Do set section headings uppercase in Bricolage with a vermilion numeral in the 3.25rem gutter.",
      "Do keep body copy at 16px mono within 68ch; switch secondary text to Graphite Ink instead of opacity.",
      "Do use 1px rules for structure and Sunk Paper only for code and command blocks.",
      "Do give every action a 2.75rem minimum height and a 2px Vermilion focus outline.",
      "Do label planned work as planned and placeholders as placeholders."
    ],
    "donts": [
      "Don't use a kicker or eyebrow line above a heading; status metadata goes below the heading it describes.",
      "Don't use cards, rounded corners, pills, shadows, gradient text, or glass.",
      "Don't use a second accent color or a dark ground.",
      "Don't let mono type carry decoration; it is the reading face of a manual.",
      "Don't hide a state change in a closed dialog; announce it where the user can still see it.",
      "Don't present a repository link, test count, or program ID that has not been verified."
    ]
  }
